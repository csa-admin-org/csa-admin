<% initial_query = params[:search].to_s.strip.presence %>

<div
  data-controller="search-modal"
  data-search-modal-initial-query-value="<%= initial_query %>"
  data-action="
    keydown.meta+k@document->search-modal#openViaShortcut:prevent
    keydown.ctrl+k@document->search-modal#openViaShortcut:prevent
  "
>
  <button
    type="button"
    class="admin-header-action"
    data-action="search-modal#openViaClick"
    title="<%= t("search.title") %> (Ctrl+K)"
  >
    <%= icon "search" %>
  </button>

  <dialog
    data-search-modal-target="dialog"
    data-action="
      click->search-modal#closeOnBackdrop
      close->search-modal#closed
      keydown.down->search-modal#navigateDown
      keydown.up->search-modal#navigateUp
      keydown.enter->search-modal#selectCurrent
    "
    aria-label="<%= t("search.title") %>"
    class="search-dialog"
  >
    <div class="search-dialog-panel">
      <%# Search input %>
      <form
        action="<%= search_path %>"
        method="get"
        data-turbo-frame="search-results"
        data-search-modal-target="form"
      >
        <div class="search-field">
          <%= icon "search", class: "search-field-icon" %>

          <input
            type="text"
            name="q"
            data-search-modal-target="input"
            data-action="input->search-modal#search"
            placeholder="<%= t("search.placeholder") %>"
            autocomplete="off"
            spellcheck="false"
            class="search-field-input"
          >

          <kbd class="kbd search-field-esc"> Esc </kbd>
        </div>
      </form>

      <%# Keyboard shortcut hint (shown only when opened via click) %>
      <div data-search-modal-target="hint" class="search-hint is-hidden">
        <span data-platform="mac" class="is-hidden">
          <%= t("search.shortcut_hint_mac_html") %>
        </span>

        <span data-platform="other" class="is-hidden">
          <%= t("search.shortcut_hint_other_html") %>
        </span>
      </div>

      <%# Results container %>
      <turbo-frame
        id="search-results"
        data-search-modal-target="results"
        data-action="turbo:frame-load->search-modal#resetSelection"
        class="search-results"
      ></turbo-frame>
    </div>
  </dialog>
</div>
