<% if @content.present? %>
  <%= @content %>
<% else %>
  <%= simple_format(@body) %>
<% end %>

<% @missing_attachments.each do |filename| %>
  <p><%= t("support.mailer.missing_attachment", filename: filename) %></p>
<% end %>

<% if @previous %>
  <p class="quoted_header"><%= @quoted_header %></p>
  <blockquote type="cite">
    <%= @quoted_html %>
  </blockquote>
<% end %>
