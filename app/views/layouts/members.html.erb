<!DOCTYPE html>

<html
  lang="<%= I18n.locale %>"
  data-theme="<%= current_member&.theme || "system" %>"
>
  <head>
    <title><%= [ Current.org.name, t(".title") ].join(" – ") %></title>

    <%= javascript_importmap_tags "members" %>
    <%= stylesheet_link_tag "trix", "member", data: { turbo_track: "reload" } %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta charset="UTF-8">
    <%= favicon_link_tag members_favicon_url, type: nil %>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%= render "shared/theme_script" %>
    <%= yield :head %>
  </head>

  <body
    class="members"
    data-controller="menu theme"
    data-theme-preference-value="<%= current_member&.theme || "system" %>"
  >
    <% if current_member %>
      <%= render "layouts/members/read_only_banner" %>
      <div class="member-app">
        <div class="member-sidebar">
          <div>
            <%= render "layouts/members/header" %>
          </div>

          <div class="member-sidebar-footer">
            <%= render "layouts/members/footer" %>
          </div>
        </div>

        <main class="member-main member-menu-hide">
          <div class="member-main-inner">
            <div class="member-flashes-slot">
              <%= render "layouts/members/flashes" %>
            </div>

            <div><%= yield %></div>
          </div>
        </main>
      </div>
    <% else %>
      <div class="member-guest">
        <div class="member-guest-frame">
          <div class="member-guest-middle">
            <header class="member-guest-header">
              <div class="member-guest-logo-wrap">
                <%= link_to Current.org.url do %>
                  <%= image_tag(org_logo_url, alt: t("accessibility.members.logo", organization: Current.org.name), class: "member-logo member-guest-logo") %>
                <% end %>
              </div>
            </header>

            <main class="member-guest-main">
              <div>
                <%= render "layouts/members/flashes" %>
                <%= yield %>
              </div>
            </main>
          </div>

          <div class="member-guest-footer">
            <%= render "layouts/members/footer" %>
          </div>
        </div>
      </div>
    <% end %>
  </body>
</html>
