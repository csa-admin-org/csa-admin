<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <title><%= strip_tags(html_head_site_title) %></title>
    <%= render "active_admin/html_head" %>
  </head>

  <body class="admin-guest">
    <div class="admin-guest-inner">
      <div class="admin-guest-logo-wrap">
        <%= image_tag(org_logo_url, size: "500", alt: "#{Current.org.name} Logo", class: "logo admin-guest-logo") %>
      </div>

      <%= render "active_admin/flash_messages" %>

      <div class="admin-guest-main"><%= yield %></div>
    </div>

    <footer class="admin-guest-footer">
      <% if Current.org.languages.many? %>
        <div class="admin-locales">
          <ul class="admin-locales-list">
            <% Current.org.languages.each do |locale| %>
              <li class="admin-locale">
                <%= link_to locale, url_for(locale: locale), title: t("languages.#{locale}"), onclick: "Turbolinks.clearCache()", class: "admin-locale-link" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="admin-credit">
        <%= link_to csa_admin_website_url, class: "admin-credit-link" do %>
          <%= icon "logo", class: "admin-credit-icon" %> CSA Admin
        <% end %>
      </div>
    </footer>
  </body>
</html>
