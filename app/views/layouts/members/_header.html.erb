<header class="member-header">
  <div class="member-sidebar-brand member-menu-hide">
    <div class="member-sidebar-brand-logo">
      <%= link_to Current.org.url do %>
        <%= image_tag(org_logo_url, alt: t("accessibility.members.logo", organization: Current.org.name), class: "member-logo") %>
      <% end %>
    </div>

    <div class="member-menu-toggle">
      <%= link_to "#menu", data: { action: "click->menu#show" } do %>
        <%= icon "menu", title: t("accessibility.members.show_menu"), class: "member-menu-icon" %>
      <% end %>
    </div>
  </div>

  <nav class="member-nav">
    <div class="member-nav-close-row">
      <%= link_to "#nomenu", data: { action: "click->menu#hide" } do %>
        <%= icon "x", title: t("accessibility.members.hide_menu"), class: "member-menu-icon" %>
      <% end %>
    </div>

    <div class="member-nav-body">
      <% membership = current_member.closest_membership %>
      <% next_basket = current_member.next_basket %>

      <ul class="member-nav-list">
        <% if current_member.baskets.any? %>
          <li class="<%= nav_class("deliveries") %>">
            <%= link_to members_deliveries_path do %>
              <h2><%= Delivery.model_name.human(count: 2) %></h2>

              <span>
                <% if next_basket %>
                  <%= t(".delivery", date: l(next_basket.delivery.date)) %>
                <% else %>
                  <%= t(".see_history") %>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>

        <% if show_shop_menu? %>
          <li
            class="member-shop-menu"
            aria-label="<%= t("accessibility.members.shop_menu") %>"
            data-test-shop-menu
          >
            <% if current_shop_delivery %>
              <%= link_to members_shop_path, class: "member-shop-menu-link" do %>
                <h2><%= t("activerecord.models.shop.one") %></h2>

                <span class="<%= nav_class("shop") if current_order&.delivery == current_shop_delivery %>">
                  <%= t(".delivery", date: l(current_shop_delivery.date)) %>
                </span>
              <% end %>
            <% end %>

            <% if !current_shop_delivery&.shop_open? && next_shop_delivery %>
              <%= link_to members_shop_next_path, class: "member-shop-menu-link" do %>
                <span class="<%= nav_class("shop") if current_order&.delivery == next_shop_delivery %>">
                  <%= t(".delivery", date: l(next_shop_delivery.date)) %>
                </span>
              <% end %>
            <% end %>

            <% if current_shop_delivery && shop_special_deliveries.any? %>
              <div class="member-shop-menu-gap"></div>
            <% end %>

            <% shop_special_deliveries.each do |delivery| %>
              <%= link_to members_shop_special_delivery_path(delivery.date), class: "member-shop-menu-link" do %>
                <% unless current_shop_delivery %>
                  <h2 class="<%= nav_class("shop") %>">
                    <%= t("activerecord.models.shop.one") %>
                  </h2>
                <% end %>

                <span class="<%= nav_class("shop") if current_order&.delivery == delivery %>">
                  <%= t(".delivery", date: l(delivery.date)) %>
                </span>
              <% end %>
            <% end %>
          </li>
        <% end %>

        <% if membership %>
          <li class="<%= nav_class("membership") %>">
            <%= link_to members_memberships_path(anchor: membership.renewal_opened? ? "renewal" : nil) do %>
              <h2><%= Membership.model_name.human %></h2>

              <% if missing_bidding_round_pledge? %>
                <span class="warning"><%= t(".bidding_round_pledge") %></span>
              <% elsif membership.renewal_opened? %>
                <span class="alert"><%= t(".membership_renewal") %></span>
              <% elsif membership.trial? %>
                <span><%= t(".membership_trial") %></span>
              <% elsif membership.current? %>
                <span><%= t(".membership_current") %></span>
              <% elsif membership.future? %>
                <span><%= t(".membership_future") %></span>
              <% else %>
                <span><%= t(".membership_past") %></span>
              <% end %>
            <% end %>
          </li>
          <% if next_basket && feature?("contact_sharing") %>
            <li class="<%= nav_class("contact_sharing") %>">
              <%= link_to members_contact_sharing_path do %>
                <h2><%= Member.human_attribute_name(:contact_sharing) %></h2>
                <span>⤷ <%= next_basket.depot.public_name %></span>
              <% end %>
            </li>
          <% end %>
        <% end %>

        <% if display_activity? %>
          <li class="<%= nav_class("activity_participations") %>">
            <%= link_to members_activity_participations_path do %>
              <h2><%= activities_human_name %></h2>

              <span>
                <% if membership&.current_or_future_year? %>
                  <%= t(".activity_participations_accepted", accepted: membership.activity_participations_accepted, count: membership.activity_participations_demanded) %>
                <% else %>
                  <%= t(".no_activity_participations_demanded") %>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>

        <li class="<%= nav_class("billing") %>">
          <%= link_to members_billing_path do %>
            <h2><%= t(".billing") %></h2>

            <% open_invoice_count = current_member.invoices.open.count %>

            <% if open_invoice_count.positive? %>
              <span class="alert">
                <%= t(".open_invoices", count: open_invoice_count) %>
              </span>
            <% else %>
              <span><%= t(".see_history") %></span>
            <% end %>
          <% end %>
        </li>

        <% if display_absence? %>
          <li class="<%= nav_class("absences") %>">
            <%= link_to members_absences_path do %>
              <h2><%= Absence.model_name.human(count: 2) %></h2>

              <span>
                <% if membership.absences_included.positive? %>
                  <%= t(".absences_used", used: membership.absences_included_used, count: membership.absences_included) %>
                <% else %>
                  <%= t(".absences_subtitle") %>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>

        <% if newsletter = MailDelivery.newsletters.processed.where(member: current_member).order(:created_at).last&.source %>
          <li class="<%= nav_class("newsletter") %>">
            <%= link_to members_newsletter_deliveries_path do %>
              <h2><%= Newsletter.model_name.human(count: 2) %></h2>

              <span>
                <% if newsletter_unsubscribed_email %>
                  <%= t(".newsletter_subscribe") %>
                <% else %>
                  <%= t(".delivery", date: l(newsletter.sent_at.to_date)) %>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>

        <li class="member-nav-account">
          <%= link_to members_account_path, class: "member-account-link" do %>
            <%= icon "circle-user-round", class: "member-account-icon" %>
            <%= current_member.name_was %>
          <% end %>
        </li>

        <li class="member-nav-logout">
          <%= button_to members_logout_path, method: :delete, class: "member-logout", form_class: "member-logout-form" do %>
            <span class="member-logout-label">
              <%= icon "log-out", class: "member-logout-icon" %>
              <%= t(".logout") %>
            </span>
          <% end %>
        </li>
      </ul>
    </div>
  </nav>
</header>
