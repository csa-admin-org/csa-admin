<% flash.each do |type, msg| %>
  <% case type %>
  <% when "alert" %>
    <div class="member-flash member-flash--alert">
      <%= icon "triangle-alert", class: "member-flash-icon" %>
      <span class="member-flash-text"><%= msg %></span>
    </div>
  <% when "notice" %>
    <div class="member-flash member-flash--notice">
      <%= icon "info", class: "member-flash-icon" %>
      <span class="member-flash-text"><%= msg %></span>
    </div>
  <% end %>
<% end %>
