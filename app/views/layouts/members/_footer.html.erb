<footer class="member-footer">
  <div class="member-footer-inner <%= " is-signed-in" if current_member %>">
    <ul class="member-footer-list <%= " is-signed-in" if current_member %>">
      <% if current_member && Current.org.feature?("member_information") %>
        <li class="member-footer-item <%= " is-signed-in" if current_member %>">
          <%= link_to members_info_path, class: "member-footer-link" do %>
            <%= icon "newspaper", class: "member-footer-link-icon" %>
            <span class="member-footer-link-label"><%= member_information_title %></span>
          <% end %>
        </li>
      <% end %>

      <% if current_member&.active? %>
        <li class="member-footer-item is-calendar <%= " is-signed-in" if current_member %>">
          <%= link_to calendar_webcal_url, class: "member-footer-link", title: t(".calendar_feed") do %>
            <%= icon "calendar-days", class: "member-footer-link-icon" %>
            <span class="member-footer-link-label"><%= t(".calendar") %></span>
          <% end %>
        </li>
      <% end %>

      <li class="member-footer-item <%= " is-signed-in" if current_member %>">
        <%= mail_to Current.org.email, class: "member-footer-link" do %>
          <%= icon "mail", class: "member-footer-link-icon" %>
          <span class="member-footer-link-label"><%= t(".contact") %></span>
        <% end %>
      </li>

      <% if Current.org.phone? %>
        <li class="member-footer-item <%= " is-signed-in" if current_member %>">
          <%= link_to "tel:#{Current.org.phone.phony_formatted(spaces: '', format: :international)}", class: "member-footer-link" do %>
            <%= icon "phone", class: "member-footer-link-icon" %>
            <span class="member-footer-link-label"><%= Current.org.phone %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <% if Current.org.social_networks.any? %>
    <div class="member-social <%= current_member ? " is-signed-in" : " is-guest" %>">
      <ul class="member-social-list <%= " is-signed-in" if current_member %>">
        <% Current.org.social_networks.each do |network| %>
          <li>
            <%= link_to network.url, class: "member-social-link" do %>
              <%= simpleicons network.icon, class: "member-social-icon" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if Current.org.languages.many? && !current_member %>
    <div class="member-locales">
      <ul class="member-locales-list">
        <% Current.org.languages.each do |locale| %>
          <li class="member-locale">
            <%= link_to locale, url_for(locale: locale), title: t("languages.#{locale}"), data: { turbolinks: false }, class: "member-locale-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="member-credit <%= " is-signed-in" if current_member %>">
    <%= link_to csa_admin_website_url, class: "member-credit-link" do %>
      <%= icon "logo", class: "member-credit-icon" %> CSA Admin
    <% end %>
  </div>
</footer>
