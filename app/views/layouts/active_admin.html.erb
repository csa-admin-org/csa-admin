<!doctype html>

<html
  lang="<%= I18n.locale %>"
  data-theme="<%= current_active_admin_user&.theme || "system" %>"
>
  <head>
    <title><%= strip_tags(html_head_site_title) %></title>
    <%= render "active_admin/html_head" %>
  </head>

  <body
    class="admin"
    data-controller="theme"
    data-theme-preference-value="<%= current_active_admin_user&.theme || "system" %>"
    data-trix-file-too-large-alert="<%= t("accessibility.trix.file_too_large") %>"
    data-trix-invalid-file-alert="<%= t("accessibility.trix.invalid_file") %>"
  >
    <%= render "active_admin/site_header", title: site_title %>
    <%= render "active_admin/page_header", title: @page_title || page_title %>
    <%= render "active_admin/flash_messages" %>

    <div
      class="admin-grid"
      data-controller="form-scroll-to-error form-sticky-actions"
      data-action="turbo:submit-start->form-scroll-to-error#observeForms"
    >
      <%= yield %>
      <%= render "active_admin/sidebar" %>
    </div>

    <%= render "active_admin/site_footer" %>
  </body>
</html>
