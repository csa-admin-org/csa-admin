# frozen_string_literal: true

active_admin_form_for bas_connection,
  url: update_bas_password_bank_connections_path,
  method: :patch,
  html: { novalidate: true, data: { turbo: false } } do |f|
  f.inputs t("active_admin.resources.bank_connection.password.form_title"), icon: "key" do
    li class: "panel-actions" do
      text_node handbook_icon_link("billing", anchor: "abs-setup")
    end

    f.semantic_errors :base

    if bas_unknown_error
      div class: "errors" do
        para sanitize(
          t(
            "active_admin.resources.bank_connection.password.unknown_html",
            password_reset_url: Billing::BAS::PASSWORD_RESET_URL),
          tags: %w[a],
          attributes: %w[href])
      end
    end

    f.input :contract_number,
      as: :string,
      label: t("active_admin.resources.bank_connection.password.fields.contract_number"),
      hint: sanitize(
        t(
          "active_admin.resources.bank_connection.password.contract_changed_html",
          handbook_url: handbook_page_path("billing", anchor: "abs-setup"),
          support_url: support_path),
        tags: %w[a],
        attributes: %w[href]
      ),
      input_html: {
        value: bas_connection.contract_number,
        disabled: true
      }

    f.input :contract_password,
      as: :password,
      label: t("active_admin.resources.bank_connection.password.fields.contract_password"),
      hint: t("active_admin.resources.bank_connection.password.hints.contract_password"),
      required: true,
      input_html: {
        value: "",
        autocomplete: "new-password"
      }
  end

  f.actions do
    f.action :submit,
      label: t("active_admin.resources.bank_connection.password.submit")
    cancel_link organization_path(anchor: "bank_connection")
  end
end
