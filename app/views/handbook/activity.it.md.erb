  <tbody>
    <tr><td><a href="/basket_sizes"><%= BasketSize.model_name.human %></a></td><td>2 all'anno</td></tr>
    <tr><td>Minimo / massimo</td><td>0 / 2</td></tr>
    <tr><td>2 scelte</td><td>prezzo dell'abbonamento invariato</td></tr>
    <tr><td>1 scelta</td><td>+<%= cur(Current.org.activity_price) %></td></tr>
