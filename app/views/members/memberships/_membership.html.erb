<div id="<%= membership.fiscal_year.year %>">
  <h2>
    <%= membership.fiscal_year %>

    <% if membership.can_member_update? && membership.can_member_update_depot? %>
      <%= link_to edit_members_membership_path(membership), title: t(".edit"), class: "membership-edit" do %>
        <%= icon "square-pen", class: "membership-edit-icon" %>
      <% end %>
    <% end %>
  </h2>

  <ul class="membership-facts">
    <li class="membership-fact is-dates">
      <%= icon "calendar-range", class: "detail-icon" %>

      <span>
        <%= [ membership.first_delivery.date, membership.last_delivery.date ].map { |d| l(d) }.join(" – ") %>
      </span>
    </li>

    <li class="membership-fact">
      <%= icon "shopping-bag", class: "detail-icon" %>

      <span class="membership-basket">
        <span><%= basket_size_description(membership) %></span>
        <% complements = membership.memberships_basket_complements.includes(:basket_complement) %>

        <% if complements.any? %>
          <span><%= basket_complements_description(complements) %></span>
        <% end %>
      </span>
    </li>

    <li class="membership-fact">
      <%= icon "map", class: "detail-icon" %>

      <span><%= depot_map_link(membership.depot) %></span>
    </li>

    <li class="membership-fact">
      <%= icon "truck", class: "detail-icon" %>

      <span><%= membership_delivery_summary(membership) %></span>
    </li>

    <% if feature?("activity") %>
      <li class="membership-fact is-activity">
        <%= icon "handshake", class: "detail-icon" %>

        <span>
          <%= activities_human_name %>:

          <%= link_to members_activity_participations_path do %>
            <%= t(".activity_participations_demanded", count: membership.activity_participations_demanded) %>
          <% end %>
        </span>
      </li>
    <% end %>

    <li class="membership-fact">
      <%= icon "banknotes", class: "detail-icon" %>

      <span>
        <% if current_member.salary_basket? %>
          <span class="salary-note"><%= t(".price_salary_basket") %></span>
        <% else %>
          <span class="membership-price">
            <% if pledge = open_bidding_round_pledge(membership) %>
              <%= link_to new_members_bidding_round_pledge_path do %>
                <%= cur(pledge.total_membership_price) %>
              <% end %>
            <% elsif membership.current? %>
              <%= link_to cur(membership.price), members_billing_path %>
            <% else %>
              <%= cur(membership.price) %>
            <% end %>

            <% if membership.invoices.any? %>
              <%= tooltip "membership-price-#{membership.id}", t(".price_tooltip") %>
            <% end %>
          </span>
        <% end %>
      </span>
    </li>
  </ul>

  <% if open_bidding_round_for?(membership) %>
    <%= link_to new_members_bidding_round_pledge_path do %>
      <div class="bidding-notice <%= missing_bidding_round_pledge? ? "is-missing" : "is-pledged" %>">
        <%= icon (missing_bidding_round_pledge? ? "mail-open" : "mail-check") %>

        <span>
          <% if missing_bidding_round_pledge? %>
            <%= t("bidding_rounds.pledge_missing_notice", number: open_bidding_round.number) %>
          <% else %>
            <% pledge = open_bidding_round_pledge(membership) %>
            <%= t("bidding_rounds.pledged_notice", number: open_bidding_round.number) %>
          <% end %>
        </span>
      </div>
    <% end %>
  <% end %>
</div>
