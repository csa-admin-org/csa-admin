<div
  id="<%= dom_id(basket) %>"
  class="basket <%= " is-absent" if basket.absent? %> <%= " is-trial" if basket.trial? %>"
>
  <div class="basket-header">
    <h3 class="basket-title">
      <%= l(basket.delivery.date, format: :long_no_year).titleize %>
    </h3>

    <div class="basket-meta">
      <% if basket.trial? %>
        <span class="basket-badge is-trial">
          <%= Basket.human_attribute_name(:trial) %>
        </span>
      <% end %>

      <% if basket.absent? %>
        <span class="basket-badge is-absent">
          <%= Absence.model_name.human %>

          <% unless basket.absence_id? %>
            *
          <% end %>
        </span>
      <% end %>

      <% if basket.can_member_update? %>
        <%= link_to edit_members_basket_path(basket), title: t(".edit") do %>
          <%= icon "square-pen", class: "icon-edit" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <ul class="basket-details <%= " is-forfeited" if basket.content_forfeited? %>">
    <li class="detail-row">
      <%= icon "shopping-bag", class: "detail-icon icon-inline" %>

      <span>
        <% if basket.shifted? %>
          <%= h basket.shift_as_source.description(public_name: true).strip %>
        <% else %>
          <%= h basket.description(public_name: true).strip %>
        <% end %>
      </span>
    </li>

    <li class="detail-row">
      <%= icon "map", class: "detail-icon icon-inline" %>

      <span><%= depot_map_link(basket.depot) %></span>
    </li>
  </ul>

  <% if basket.shifted? %>
    <div class="basket-footer is-quiet">
      <%= link_to url_for(anchor: dom_id(basket.shift_as_source.target_basket)), class: "basket-action", data: { turbo: false } do %>
        <%= icon "redo", class: "icon-inline" %>
        <%= t(".shifted", target_date: l(basket.shift_as_source.target_basket.delivery.date, format: :long_no_year)) %>
      <% end %>
    </div>
  <% elsif basket.shift_declined? %>
    <div class="basket-footer is-quiet is-italic">
      <%= icon "redo-off", class: "icon-inline" %>
      <%= t(".shift_declined") %>
    </div>
  <% elsif basket.can_member_force? %>
    <div class="basket-footer">
      <%= button_to members_basket_forced_delivery_path(basket), method: :post, class: "basket-force" do %>
        <%= icon "circle-check-big", class: "icon-inline" %>
        <%= t(".force") %>
      <% end %>
    </div>
  <% elsif Current.org.basket_shift_enabled? %>
    <% if basket.can_be_member_shifted? %>
      <div class="basket-footer">
        <%= link_to new_members_basket_basket_shifts_path(basket), class: "basket-action" do %>
          <%= icon "redo", class: "icon-inline" %>
          <%= t(".shift") %>
        <% end %>
      </div>
    <% elsif basket.absent? %>
      <div class="basket-footer is-quiet is-italic">
        <%= t(".shift_not_possible") %>
      </div>
    <% end %>
  <% end %>
</div>
