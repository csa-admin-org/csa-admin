<h1><%= @bidding_round.title %></h1>

<section>
  <p class="pledge-intro"><%= @bidding_round.information_text %></p>

  <%= turbo_frame_tag "membership-pricing", type: "morph" do %>
    <% membership = @pledge.membership %>

    <div
      class="pledge-card"
      data-controller="hover"
      data-action="mouseenter->hover#show mouseleave->hover#hide"
      data-hover-id-value="<%= dom_id(membership) %>"
    >
      <div class="pledge-title">
        <%= Membership.model_name.human %> <%= membership.fiscal_year %>
      </div>

      <ul class="pledge-lines">
        <li class="pledge-line">
          <span class="pledge-label">
            <%= Basket.model_name.human(count: membership.baskets_count) %>
          </span>

          <span class="pledge-value">
            <%= display_price_description(
              @pledge.total_membership_baskets_price,
              safe_join([
                "#{membership.baskets_count}x ",
                content_tag(
                  :span,
                  precise_cur(@pledge.basket_size_price),
                  class: "pledge-flash"
                )
              ])
            ) %>
          </span>
        </li>

        <%= render "members/shared/membership_price_lines", membership: membership %>

        <li class="pledge-total">
          <span class="pledge-total-amount">
            <%= cur(@pledge.total_membership_price, format: "%u %n") %>
          </span>
        </li>

        <% unless membership.billing_year_division == 1 %>
          <li class="pledge-installment">
            <span class="pledge-installment-amount">
              <span class="pledge-division">
                <%= t("billing.year_division.x#{membership.billing_year_division}") %>:
              </span>

              <%= cur(@pledge.total_membership_price / membership.billing_year_division.to_f, format: "%u %n") %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @pledge,
    url: members_bidding_round_pledge_path,
    method: :post,
    class: "pledge-form",
    data: {
      controller: "price-range",
      price_range_default_price_value: @pledge.default_price,
      price_range_snap_prices_value: @pledge.basket_size_price_snap_prices.to_json
    } do |f| %>
    <div class="input pledge-input-label">
      <%= f.label :basket_size_price %>
    </div>

    <div class="pledge-range-block">
      <!-- Price range display (only over slider) -->
      <div class="pledge-range-labels">
        <span><%= cur(@pledge.min_allowed_price) %></span>
        <span><%= cur(@pledge.max_allowed_price) %></span>
      </div>

      <div class="pledge-range">
        <div class="pledge-range-track">
          <%= range_field_tag :basket_size_price_range, @pledge.basket_size_price,
            min: @pledge.min_allowed_price,
            max: @pledge.max_allowed_price,
            step: 0.01,
            class: "pledge-range-input",
            data: {
              action: "pointerdown->price-range#startDrag price-range#syncFromRange",
              price_range_target: "range"
            } %>

          <div class="pledge-ticks" aria-hidden="true">
            <% @pledge.basket_size_price_tick_ratios.each do |ratio| %>
              <span
                class="pledge-tick"
                style="--tick: <%= format("%.6f", ratio) %>"
              ></span>
            <% end %>

            <% if (ratio = @pledge.default_price_tick_ratio) %>
              <span
                class="pledge-tick is-default"
                style="--tick: <%= format("%.6f", ratio) %>"
              ></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="pledge-controls">
      <div class="pledge-recommended">
        <%= button_tag t(".recommended_price"),
          type: "button",
          disabled: @pledge.default_price == @pledge.basket_size_price,
          class: "btn btn-light btn-sm",
          data: {
            action: "price-range#setDefaultPrice",
            price_range_target: "reset"
          } %>

        <% difference = @pledge.default_price_percentage_difference %>

        <span class="pledge-percent" data-price-range-target="percent"><%= _number_to_percentage(difference, precision: 0) if difference %></span>
      </div>

      <div class="pledge-amount">
        <span><%= currency_symbol %></span>

        <%= f.number_field :basket_size_price,
          value: precise_cur(@pledge.basket_size_price),
          min: @pledge.min_allowed_price,
          max: @pledge.max_allowed_price,
          step: 0.5,
          class: "form-amount",
          required: true,
          data: {
            action: "price-range#syncFromInput invalid->price-range#allowCentPrice",
            price_range_target: "input"
          } %>
      </div>
    </div>

    <div class="actions">
      <%= button_tag type: "submit", data: { disable_with: t("formtastic.processing") } do %>
        <%= icon "check", class: "icon-inline-action" %>
        <span><%= t(".submit") %></span>
      <% end %>
    </div>
  <% end %>
</section>
