<h1><%= Member.human_attribute_name(:contact_sharing) %></h1>

<section>
  <h2><%= Depot.model_name.human %>: <%= @depot.public_name %></h2>

  <% if current_member.errors.none? && current_member.contact_sharing? %>
    <p class="contact-blurb"><%= t(".description") %></p>
    <% if @members.empty? %>
      <p class="nocontent contacts-empty">
        <%= t(".nobody_sharing_contact") %>
      </p>
    <% else %>
      <ul id="members" class="contacts">
        <% @members.each do |member| %>
          <li class="contact">
            <h3 class="contact-name">
              <%= member.name %>
            </h3>

            <ul class="contact-facts">
              <li class="contact-fact">
                <%= icon "phone", class: "detail-icon" %>
                <span><%= display_phones(member) %></span>
              </li>

              <li class="contact-fact">
                <%= icon "map", class: "detail-icon" %>
                <span><%= display_address(member) %></span>
              </li>
            </ul>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="explanation">
      <%= t(".cancel_sharing_html", email: Current.org.email) %>
    </p>
  <% else %>
    <p class="contact-prompt"><%= t(".explanation") %></p>
    <%= simple_form_for current_member, url: members_contact_sharing_path, method: :post, html: { class: "contact-form" } do |f| %>
      <div class="check_boxes">
        <div class="checkbox">
          <%= f.input :contact_sharing, as: :hidden, input_html: { value: true } %>
          <%= f.input :terms_of_service, as: :boolean, label: t(".terms_of_service") %>
        </div>
      </div>

      <div class="actions">
        <%= button_tag type: "submit" do %>
          <%= icon "check", class: "icon-inline-action" %>
          <span><%= t(".submit") %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
