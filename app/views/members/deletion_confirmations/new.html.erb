<h1><%= t(".title") %></h1>

<section>
  <%= notice_pane("mail") do %>
    <%= t(".code_sent_html", email: content_tag(:strong, current_session.email)) %>
  <% end %>

  <h2 class="deletion-title"><%= t(".what_happens_title") %></h2>

  <div class="deletion-copy">
    <ul class="deletion-list">
      <li><%= t(".what_happens.immediate_logout") %></li>
      <li><%= t(".what_happens.anonymization_delay") %></li>
      <li><%= t(".what_happens.invoices_retained") %></li>
    </ul>
  </div>

  <%= form_with url: members_account_deletion_confirmation_path, method: :post do |f| %>
    <div class="deletion-form">
      <div class="deletion-code">
        <label for="code" class="deletion-code-label">
          <%= t(".code_label") %>
        </label>

        <input
          type="text"
          name="code"
          id="code"
          autocomplete="one-time-code"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="6"
          required
          class="deletion-code-input"
          placeholder="000000"
        >
      </div>

      <div class="actions">
        <%= link_to members_account_path, class: "cancel-link" do %>
          <%= icon "arrow-left", class: "icon-inline-action" %>
          <span><%= t(".cancel") %></span>
        <% end %>

        <%= button_tag type: "submit", class: "destructive" do %>
          <%= icon "trash", class: "icon-inline-action" %>
          <span><%= t(".confirm") %></span>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
