<h1><%= t(".title") %></h1>

<section>
  <ul class="account-list">
    <li class="account-row is-id">
      <%= icon "hash", class: "icon-inline account-id-icon" %>
      <span><%= current_member.id %></span>
    </li>

    <li class="account-row">
      <%= icon "id-card", class: "icon-md" %>
      <span><%= current_member.name %></span>
    </li>

    <li class="account-row">
      <%= icon "map", class: "icon-md" %>
      <span><%= display_address(current_member) %></span>
    </li>

    <% if current_member.delivery_note? %>
      <li class="account-row">
        <%= icon "notepad-text", class: "icon-md" %>
        <span><%= current_member.delivery_note %></span>
      </li>
    <% end %>

    <li class="account-row">
      <%= icon "mail", class: "icon-md" %>
      <span><%= display_emails(current_member) %></span>
    </li>

    <li class="account-row">
      <%= icon "phone", class: "icon-md" %>

      <% if current_member.phones_array.any? %>
        <span><%= display_phones(current_member) %></span>
      <% else %>
        <span class="is-muted is-italic"><%= t(".no_phones") %></span>
      <% end %>
    </li>

    <% if current_member.different_billing_info %>
      <li class="account-row">
        <%= icon "banknotes", class: "icon-md" %>

        <span>
          <%= current_member.billing_name %>
          <br>
          <%= display_billing_address(current_member) %>
        </span>
      </li>
    <% end %>

    <% if current_member.use_shop_depot? %>
      <li class="account-row is-shop">
        <%= icon "shopping-basket", class: "icon-md" %>

        <span><%= depot_map_link(current_member.shop_depot) %></span>
      </li>
    <% end %>

    <hr class="rule">

    <% if Current.org.languages.many? %>
      <li class="account-row">
        <%= icon "languages", class: "icon-md" %>
        <span><%= t("languages.#{current_member.language}") %></span>
      </li>
    <% end %>

    <% theme = current_member.theme %>
    <% theme_icon = HasTheme::THEME_ICONS.fetch(theme) %>

    <li class="account-row">
      <%= icon theme_icon, class: "icon-md" %>
      <span><%= t("themes.#{theme}") %></span>
    </li>
  </ul>

  <div class="account-actions">
    <%= link_to edit_members_account_path, class: "btn" do %>
      <%= icon "square-pen", class: "icon-btn" %>
      <span><%= t(".edit_link") %></span>
    <% end %>
  </div>

  <%= render "members/billing/sepa" %>

  <div class="account-delete">
    <%= link_to new_members_account_deletion_request_path, class: "account-delete-link" do %>
      <%= icon "trash", class: "icon-sm" %>

      <span class="account-delete-label"><%= t(".delete_account_link") %></span>
    <% end %>
  </div>
</section>
