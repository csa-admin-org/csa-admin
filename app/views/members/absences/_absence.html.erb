<li class="absence">
  <span class="absence-dates">
    <%= l(absence.started_on) %> – <%= l(absence.ended_on) %>
    (<%= t(".deliveries_count", count: absence.baskets.size) %>)
  </span>

  <% if absence.note? %>
    <%= tooltip("absence-#{absence.id}", absence.note, icon_name: "message-square-text") %>
  <% end %>

  <% if absence.present_or_future? %>
    <span class="absence-actions">
      <%= button_to [ :members, absence ], method: :delete,
        class: "icon-destroy",
        form_class: "inline-form",
        form: { data: { turbo: false } },
        data: { confirm: t(".destroy_confirm"), disable: true },
        "aria-label": t(".cancel_link") do %>
        <%= icon "trash", class: "icon-sm" %>
        <span class="sr-only"><%= t(".cancel_link") %></span>
      <% end %>
    </span>
  <% end %>
</li>
