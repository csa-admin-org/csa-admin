<%= turbo_frame_tag @delivery do %>
  <div data-controller="iframe">
    <%= tag.iframe(
      title: t("accessibility.members.mail_preview"),
      srcdoc: @delivery.mail_preview,
      scrolling: "no",
      class: "mail_preview",
      data: { iframe_target: "iframe" }
    ) %>
  </div>
<% end %>
