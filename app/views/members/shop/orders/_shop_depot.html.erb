<% depot = order.depot %>

<div class="shop-depot">
  <h2 class="shop-depot-title">
    <span><%= Depot.model_name.human %>:</span>

    <span class="shop-depot-name"><%= depot_map_link(depot) %></span>
  </h2>

  <% if depot&.public_note? %>
    <div class="shop-depot-note"><%= depot.public_note %></div>
  <% end %>
</div>
