<% order.state = Shop::Order::PENDING_STATE %>

<% order.validate %>

<% order.state = Shop::Order::CART_STATE %>

<% order.items.each(&:validate) %>

<% submit_disabled = order.items.any? { |i| i.errors.any? } || order.errors.any? %>

<%= simple_form_for order, url: members_shop_order_path(order), method: :patch, data: { controller: "form-submitter", form_submitter_target: "form" } do |f| %>
  <div class="shop-order-items">
    <%= f.simple_fields_for :items, order.items.sort_by { |i| [ i.product.name, i.product_variant.name ] } do |ff| %>
      <div class="shop-order-item">
        <%= ff.label :quantity, class: "shop-order-item-label" do %>
          <div class="shop-order-item-info">
            <span class="shop-order-item-name">
              <%= ff.object.product.name %>,
              <%= ff.object.product_variant.name %>
            </span>

            <span class="shop-order-item-price">
              <%= cur(ff.object.item_price) %>
            </span>

            <% if available_products.exclude?(ff.object.product) || ff.object.product_variant.unavailable? %>
              <span class="shop-stock is-low"><%= t(".unavailable") %></span>
            <% elsif !ff.object.product_variant.available_stock?(ff.object.quantity + 5) %>
              <span class="shop-stock is-low">
                <%= t(".stock", count: ff.object.product_variant.stock) %>
              </span>
            <% end %>
          </div>

          <div class="shop-order-item-totals">
            <span
              class="shop-order-item-amount"
              title="<%= ff.object.quantity %> x <%= cur(ff.object.item_price) %>"
            >
              <%= cur(ff.object.amount) %>
            </span>

            <%= ff.input :quantity, as: :numeric, label: false, wrapper_html: { class: "shop-qty", data: { controller: "form-number-controls" } } do %>
              <button
                aria-label="<%= t("accessibility.members.decrease_quantity", product: [ ff.object.product.name, ff.object.product_variant.name ].join(", ")) %>"
                class="shop-qty-btn is-minus"
                data-action="form-number-controls#decrement"
              >
                <div class="shop-qty-btn-icon">
                  <% if ff.object.quantity == 1 %>
                    <%= icon "trash", class: "shop-qty-icon is-trash" %>
                  <% else %>
                    <%= icon "minus", class: "shop-qty-icon" %>
                  <% end %>
                </div>
              </button>

              <%= ff.input_field :quantity, class: "shop-qty-input controls-none", min: 0, max: ff.object.product_variant.stock || 99, data: { form_number_controls_target: "input", action: "change->form-submitter#submit" } %>
              <% disabled = available_products.exclude?(ff.object.product) || ff.object.product_variant.unavailable? || (ff.object.product_variant.stock && ff.object.quantity >= ff.object.product_variant.stock.to_i) %>

              <%= tag.button(
                "aria-label": t("accessibility.members.increase_quantity", product: [ ff.object.product.name, ff.object.product_variant.name ].join(", ")),
                class: "shop-qty-btn is-plus",
                "data-action": "form-number-controls#increment",
                disabled: disabled
              ) do %>
                <div class="shop-qty-btn-icon">
                  <%= icon "plus", class: "shop-qty-icon" %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="shop-order-footer">
    <% if Current.org.shop_member_percentages? %>
      <div class="shop-percentage">
        <%= f.select :amount_percentage, shop_member_percentages_collection, { include_blank: shop_member_percentages_label(order) }, class: "shop-percentage-select", data: { action: "form-submitter#submit" } %>
      </div>
    <% end %>

    <div class="shop-totals">
      <% if f.object.amount_percentage? %>
        <div class="shop-percentage-lines">
          <div class="shop-subtotal-row">
            <span class="shop-subtotal">
              <span><%= t(".total") %></span>

              <span class="shop-money">
                <%= cur(f.object.amount_before_percentage) %>
              </span>
            </span>
          </div>

          <div class="shop-percent-row">
            <span class="shop-percent">
              <span>
                <%= _number_to_percentage(f.object.amount_percentage, precision: 1) %>
              </span>

              <span class="shop-money">
                <%= cur(f.object.amount - f.object.amount_before_percentage) %>
              </span>
            </span>
          </div>
        </div>
      <% end %>

      <span class="shop-grand">
        <span><%= t(".total") %></span>
        <span class="shop-money"><%= cur(f.object.amount) %></span>
      </span>
    </div>

    <div class="shop-weight" title="<%= t(".order_total_weight") %>">
      <%= icon "scale", class: "shop-icon-sm" %>
      <span class="shop-weight-value"><%= kg(f.object.weight_in_kg) %></span>
    </div>
  </div>

  <%= f.button :submit, t(".submit_order"), class: "is-hidden", data: { test_update_order: true } %>
<% end %>

<% if order.errors[:base].any? %>
  <div class="shop-errors">
    <span class="shop-error"><%= order.errors[:base].join(", ") %></span>
  </div>
<% end %>

<div class="actions shop-actions">
  <div class="shop-actions-continue">
    <%= link_to shop_path, class: "cancel-link", target: "_top" do %>
      <%= icon "arrow-left", class: "icon-inline" %>
      <span><%= t(".continue_shopping") %></span>
    <% end %>
  </div>

  <div class="shop-actions-confirm">
    <%= button_to confirm_members_shop_order_path(order), disabled: submit_disabled, form: { data: { turbo: false }, class: "shop-confirm-form" }, data: { test_confirm_order: true } do %>
      <%= icon "check", class: "icon-inline" %>
      <span><%= t(".submit_order") %></span>
    <% end %>
  </div>
</div>

<div class="shop-destroy-wrap">
  <%= button_to members_shop_order_path(order), method: :delete, form: { data: { turbo: false, controller: "confirmation", confirmation_message_value: t(".destroy_cart_confirm"), action: "submit->confirmation#confirm" } }, class: "shop-destroy" do %>
    <div class="shop-destroy-inner">
      <%= icon "trash", class: "shop-icon-sm" %>
      <span class="shop-destroy-label"><%= t(".destroy_cart") %></span>
    </div>
  <% end %>
</div>

<% if current_member.use_shop_depot? %>
  <%= render "members/shop/orders/shop_depot", order: order %>
<% end %>
