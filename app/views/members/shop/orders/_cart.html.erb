<% if order.items.none? %>
  <div class="shop-cart-empty">
    <div class="shop-cart-empty-inner">
      <%= icon "shopping-basket", class: "shop-cart-empty-icon" %>

      <div class="shop-cart-empty-label">
        <%= t(".no_order_items") %>
      </div>
    </div>
  </div>
<% else %>
  <div class="shop-cart">
    <%= link_to members_shop_order_path(order), target: "_top", title: t(".show_basket"), class: "shop-cart-link" do %>
      <%= icon "shopping-basket", class: "shop-cart-icon" %>

      <div class="shop-cart-count">
        <% count = order.items.sum(:quantity) %>
        <%= count %> <%= Shop::Product.model_name.human(count: count) %>
      </div>

      <div class="shop-cart-amount">
        <%= cur order.items.sum(&:amount) %>
      </div>

      <div class="shop-cart-go">
        <div class="shop-cart-go-btn">
          <%= icon "chevron-right", class: "shop-cart-go-icon" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
