<div class="shop-order-items">
  <% order.items.sort_by { |i| [ i.product.name, i.product_variant.name ] }.each do |item| %>
    <div class="shop-finalized-item">
      <div class="shop-finalized-info">
        <span>
          <b><%= item.quantity %></b> x <%= item.product.name %>,
          <%= item.product_variant.name %>
        </span>

        <span class="shop-finalized-price"><%= cur(item.item_price) %></span>
      </div>

      <div class="shop-finalized-amount">
        <span
          class="shop-order-item-amount"
          title="<%= item.quantity %> x <%= cur(item.item_price) %>"
        >
          <%= cur(item.amount) %>
        </span>
      </div>
    </div>
  <% end %>
</div>

<% if order.amount_percentage? %>
  <div class="shop-finalized-subtotal-row">
    <span class="shop-finalized-subtotal">
      <span><%= t(".total") %></span>

      <span class="shop-money"><%= cur(order.amount_before_percentage) %></span>
    </span>
  </div>
  <div class="shop-finalized-percent-row">
    <span class="shop-percent">
      <span>
        <%= _number_to_percentage(order.amount_percentage, precision: 1) %>
      </span>

      <span class="shop-money">
        <%= cur(order.amount - order.amount_before_percentage) %>
      </span>
    </span>
  </div>
<% end %>

<div class="shop-finalized-footer">
  <div class="shop-finalized-weight" title="<%= t(".order_total_weight") %>">
    <%= icon "scale", class: "shop-icon-sm" %>
    <span class="shop-weight-value"><%= kg(order.weight_in_kg) %></span>
  </div>

  <div class="shop-finalized-total">
    <span class="shop-grand">
      <span><%= t(".total") %></span>
      <span class="shop-money"><%= cur(order.amount) %></span>
    </span>
  </div>
</div>

<% if order.pending? && order.can_member_update? %>
  <div class="shop-unconfirm">
    <div class="actions shop-actions-confirm">
      <%= button_to t(".unconfirm_order"), unconfirm_members_shop_order_path(order), form: { data: { turbo: false }, class: "shop-confirm-form" } %>
    </div>
  </div>
  <div class="shop-destroy-wrap">
    <%= button_to members_shop_order_path(order), method: :delete, form: { data: { turbo: false, controller: "confirmation", confirmation_message_value: t(".cancel_order_confirm"), action: "submit->confirmation#confirm" } }, class: "shop-destroy" do %>
      <div class="shop-destroy-inner">
        <%= icon "trash", class: "shop-icon-sm" %>
        <span class="shop-destroy-label"><%= t(".cancel_order") %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="nocontent shop-contact">
    <%= t(".contact_us_html", email: Current.org.email) %>
  </p>
<% end %>

<% if current_member.use_shop_depot? %>
  <%= render "members/shop/orders/shop_depot", order: order %>
<% end %>

<% if next_shop_delivery && order.delivery == current_shop_delivery && order.shop_open? %>
  <p class="shop-next-note">
    <%= t("members.shop.products.index.next_delivery_html",
      date: l(next_shop_delivery.date, format: :long),
      start_date: l(order.delivery.shop_closing_at, format: :long),
      end_date: l(next_shop_delivery.shop_closing_at, format: :long)) %>
  </p>
<% end %>
