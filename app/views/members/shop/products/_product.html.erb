<div>
  <h3 class="shop-product-name">
    <span><%= product.name %></span>

    <% if product.tags.any? %>
      <ul class="shop-product-tags">
        <% product.tags.each do |tag| %>
          <li>
            <%= render partial: "members/shop/products/tag", object: tag %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </h3>

  <% if params[:producer_id].blank? && product.producer_id? %>
    <div class="shop-product-producer">
      <span class="shop-product-producer-row">
        <%= link_to params.merge(producer_id: product.producer_id) do %>
          <%= product.producer.name %>
        <% end %>

        <% if product.producer.website_url? %>
          <%= link_to product.producer.website_url, target: :blank, class: "shop-product-site" do %>
            <%= icon "link", class: "shop-icon-sm" %>
          <% end %>
        <% end %>
      </span>
    </div>
  <% end %>

  <% if product.description? %>
    <div class="shop-product-desc"><%= product.description %></div>
  <% end %>

  <ul class="shop-variants">
    <% product.variants.select { |variant| variant.available_for_delivery?(delivery) }.each do |variant| %>
      <li class="shop-variant-row">
        <%= turbo_frame_tag "product_variant_#{variant.id}" do %>
          <%= render partial: "members/shop/products/variant", object: variant, locals: { order: order } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
