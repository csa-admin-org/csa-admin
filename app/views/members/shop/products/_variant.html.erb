<% live_stock = live_stock(variant, order) %>

<div class="shop-variant <%= " is-sold-out" if live_stock&.zero? %>">
  <div class="shop-variant-main">
    <span><%= variant.name %></span>

    <% case live_stock %>
    <% when 1..5 %>
      <span class="shop-stock is-low">
        <%= t(".live_stock", count: live_stock) %>
      </span>
    <% when ..0 %>
      <span class="shop-stock is-empty"><%= t(".live_stock", count: 0) %></span>
    <% end %>
  </div>

  <div class="shop-variant-price"><%= cur(variant.price) %></div>

  <div class="shop-variant-action">
    <% if !live_stock || live_stock.positive? %>
      <%= button_to members_shop_order_order_items_path(order), method: :post, title: t(".add_to_basket"), class: "shop-add", disabled: live_stock&.zero?, params: { variant_id: variant.id } do %>
        <%= icon "shopping-basket", class: "shop-add-icon" %>
      <% end %>
    <% else %>
      <span class="shop-add is-disabled">
        <%= icon "shopping-basket", class: "shop-add-icon" %>
      </span>
    <% end %>
  </div>
</div>
