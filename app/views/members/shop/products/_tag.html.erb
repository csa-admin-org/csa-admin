<% if params[:tag_id] == tag.id.to_s %>
  <%= link_to params.merge(tag_id: nil) do %>
    <span class="shop-tag is-selected">
      <%= tag.emoji %>
      <span class="shop-tag-name"><%= tag.name %></span>
    </span>
  <% end %>
<% else %>
  <%= link_to params.merge(tag_id: tag.id) do %>
    <span class="shop-tag">
      <%= tag.emoji %>
      <span class="shop-tag-name"><%= tag.name %></span>
    </span>
  <% end %>
<% end %>
