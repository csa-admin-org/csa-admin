<%= render partial: "members/shop/shared/header", locals: { order: @order } %>

<p class="shop-lede">
  <%= t(".#{@order.shop_open? ? :closing_at_html : :closed_at_html}", date: l(@order.delivery.shop_closing_at, format: :long)) %>
</p>

<% if @order.shop_open? %>
  <div class="member-shop-sticky-slot">
    <div
      data-controller="sticky"
      data-sticky-target="container"
      data-sticky-offset-value="114"
      data-sticky-desktop-offset-value="178"
      data-sticky-sticky-class="member-shop-sticky"
      data-action="scroll@window->sticky#update resize@window->sticky#update"
    >
      <div class="member-shop-sticky-shell">
        <div class="shop-cart-frame">
          <%= turbo_frame_tag "cart" do %>
            <%= render partial: "members/shop/orders/cart", locals: { order: @order } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <section>
    <h2><%= t(".available_product") %></h2>

    <% if available_producers.any? %>
      <div class="shop-producer-filter" data-controller="form-submitter">
        <%= form_tag shop_path, method: :get, data: { form_submitter_target: "form" } do %>
          <% if params[:tag_id].present? %>
            <%= hidden_field_tag :tag_id, params[:tag_id] %>
          <% end %>

          <%= select_tag :producer_id, options_from_collection_for_select(available_producers, :id, :name, params[:producer_id]), include_blank: t(".all_producers"), class: "shop-producer-select #{'is-filtered' if params[:producer_id].present?}", data: { action: "form-submitter#submit" } %>
        <% end %>
      </div>
    <% end %>

    <% if available_tags.any? %>
      <ul class="shop-tags">
        <% available_tags.each do |tag| %>
          <li>
            <%= render partial: "members/shop/products/tag", object: tag %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if params[:producer_id].present? %>
      <% producer = Shop::Producer.find(params[:producer_id]) %>
      <% if producer.description? || producer.website_url? %>
        <div class="shop-producer-card">
          <% if producer.description? %>
            <div><%= producer.description %></div>
          <% end %>

          <% if producer.website_url? %>
            <%= link_to producer.website_url, producer.website_url, target: :blank, class: "shop-producer-site" %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <div class="shop-products">
      <%= render partial: "members/shop/products/product", collection: available_products, locals: { order: @order } %>
    </div>
  </section>
<% else %>
  <% if next_shop_delivery %>
    <div class="shop-next">
      <%= link_to members_shop_next_path, class: "shop-next-link" do %>
        <div class="shop-next-inner">
          <%= icon "shopping-basket", class: "icon-inline" %>

          <span class="shop-next-label">
            <%= t(".next_shop_delivery_link", date: l(next_shop_delivery.date, format: :long)) %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render "members/shop/shared/terms_of_sale" %>
