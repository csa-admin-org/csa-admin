<h1>
  <%= t(".title_html", date: content_tag(:span, l(@basket.delivery.date), class: "is-nowrap")) %>
</h1>

<section>
  <h2><%= t(".subtitle") %></h2>

  <div class="form-copy">
    <p><%= t(".text") %></p>

    <% if Current.org.basket_shift_annual_limit? %>
      <p>
        <%= t(".limit_text_html", count: @basket.membership.basket_shifts_allowance_remaining) %>
      </p>
    <% end %>

    <% if Current.org.basket_shift_deadline_enabled? %>
      <p>
        <%= t(".deadline_text_html", count: Current.org.basket_shift_deadline_in_weeks) %>
      </p>
    <% end %>

    <% unless @basket.billable? %>
      <p><%= t(".absences_included_warning") %></p>
    <% end %>

    <%= form_for @basket, url: members_basket_basket_shifts_path(@basket), method: :post, html: { class: "form-root" } do |f| %>
      <div class="input">
        <%= f.label :shift_target_basket_id %>
        <%= f.select :shift_target_basket_id, basket_shift_targets_member_collection(@basket), { include_blank: false } %>
      </div>

      <div class="actions">
        <%= link_to members_deliveries_path, class: "cancel-link" do %>
          <%= icon "arrow-left", class: "icon-inline" %>
          <span><%= t(".cancel_link") %></span>
        <% end %>

        <%= button_tag type: "submit" do %>
          <%= icon "check", class: "icon-inline" %>
          <span><%= t(".submit") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
