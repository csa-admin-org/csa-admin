<h1 class="activity-heading">
  <%= activities_human_name %>
  <%= render "members/calendars/subscribe_button" %>
</h1>

<section>
  <h2><%= t(".activity_participation_form_title") %></h2>

  <% if @activities.empty? %>
    <p class="nocontent copy"><%= t(".no_activities") %></p>
  <% else %>
    <div
      class="activities-form"
      data-controller="calendar"
      data-calendar-dates-value="<%= @activities.map(&:date).uniq.as_json %>"
      data-calendar-non-full-dates-value="<%= @activities.select(&:missing_participants?).map(&:date).uniq.as_json %>"
      data-calendar-default-date-value="<%= @activity_participation.date %>"
    >
      <%= simple_form_for @activity_participation, url: [ :members, @activity_participation ] do |f| %>
        <% if @activities.map(&:title).uniq.many? %>
          <div class="activity-filter">
            <%= select_tag :activity_title, activities_titles_options(@activities), class: "select-sm activity-title-select", data: { action: "calendar#filterDates" } %>
          </div>
        <% end %>

        <div class="activity-calendar">
          <div data-calendar-target="calendar"></div>
        </div>

        <div class="activity-fields">
          <%= f.input :activity_ids, as: :check_boxes, collection: activities_collection(@activities, data: { calendar_target: "input" }), disabled: @activities.select(&:full?).map(&:id), required: true, label: t(".activity_label"), wrapper_html: { data: { form_disabler_target: "label" } } %>
          <%= f.input :participants_count, as: :numeric, required: true, label: t(".participants_count_label"), input_html: { step: 1, min: 1, class: "form-narrower" } %>
          <%= f.input :note, input_html: { rows: 2 } %>

          <div data-controller="form-checkbox-toggler" class="carpool">
            <legend>
              <div class="carpool-legend">
                <span><%= t(".carpooling") %></span>
                <%= tooltip("carpooling", t(".carpooling_tooltip")) %>
              </div>
            </legend>

            <%= f.input :carpooling, as: :boolean, label: t(".carpooling_checkbox"), input_html: { data: { form_checkbox_toggler_target: "checkbox", action: "form-checkbox-toggler#toggleInput" } } %>

            <div>
              <%= f.input :carpooling_phone, label: false, input_html: { placeholder: t(".carpooling_phone"), data: { form_checkbox_toggler_target: "input" } } %>
              <%= f.input :carpooling_city, label: false, input_html: { placeholder: t(".carpooling_city"), data: { form_checkbox_toggler_target: "input" } } %>
            </div>
          </div>

          <div class="actions">
            <%= button_tag type: "submit", data: { calendar_target: "submit" } do %>
              <%= icon "check", class: "icon-inline-action" %>
              <span><%= t(".activity_form_submit") %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<% @coming_participations = current_member.activity_participations.coming.includes(:activity).merge(Activity.ordered(:asc)) %>

<% if @coming_participations.any? %>
  <section>
    <h2><%= t(".coming_activity_participations") %></h2>

    <ul id="coming_participations" class="activity-list">
      <%= render @coming_participations %>
    </ul>

    <% if @coming_participations.any? { |p| !p.destroyable? } %>
      <p class="activity-cancel-hint">
        <%= t(".coming_activity_participation_cannot_be_cancel_explanation_html",
          days_count: Current.org.activity_participation_deletion_deadline_in_days,
          contact_link: mail_to(Current.org.email, t(".contact_link"))) %>
      </p>
    <% else %>
      <p class="nocontent">
        <%= t(".edit_activity_participation_explanation") %>
      </p>
    <% end %>
  </section>
<% end %>

<section>
  <h2><%= t(".past_activity_participations") %></h2>

  <% @past_participations = current_member.activity_participations.past_current_year.includes(:activity).merge(Activity.ordered(:desc)) %>

  <% if @past_participations.empty? %>
    <p class="nocontent"><%= t(".no_past_activity_participations") %></p>
  <% else %>
    <ul class="activity-list"><%= render @past_participations %></ul>
  <% end %>
</section>
