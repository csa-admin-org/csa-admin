<h3 class="heading-sm">
  <%= Current.org.basket_content_member_title %>
</h3>

<ul class="basket-contents">
  <% basket_contents.each do |bc| %>
    <li class="basket-contents-item">
      <span class="basket-contents-mark">
        <span class="basket-contents-dot"></span>
      </span>

      <span>
        <% if Current.org.basket_content_member_display_product_url? && bc.product.url? %>
          <%= link_to bc.product.name, bc.product.url %>
        <% else %>
          <%= bc.product.name %>
        <% end %>

        <% if Current.org.basket_content_member_display_quantity? %>
          <span class="is-muted">
            (<%= display_quantity(bc.basket_quantity(basket_size), bc.unit) %>)
          </span>
        <% end %>
      </span>
    </li>
  <% end %>
</ul>

<% if Current.org.basket_content_member_note.present? %>
  <p class="basket-contents-note">
    * <%= Current.org.basket_content_member_note %>
  </p>
<% end %>
