<h1 class="page-heading">
  <%= Delivery.model_name.human(count: 2) %>
  <%= render "members/calendars/subscribe_button" %>
</h1>

<%= render "absences_included_notice" %>

<% if @next_basket %>
  <section>
    <h2><%= t(".next_delivery") %></h2>

    <ul class="list">
      <li class="list-item"><%= render @next_basket %></li>
    </ul>

    <% if @next_basket&.depot&.public_note? %>
      <h3 class="heading-sm">
        <%= t(".depot_note", depot: @next_basket.depot.public_name) %>
      </h3>
      <div class="form-copy-gap">
        <%= @next_basket.depot.public_note %>
      </div>
    <% end %>

    <%= render "basket_contents", basket_contents: @basket_contents, basket_size: @next_basket.basket_size if @basket_contents&.any? %>
  </section>
<% end %>

<section id="future_deliveries">
  <h2><%= t(".future_deliveries") %></h2>

  <%= render "baskets_list", baskets: @future_baskets, empty_text: t(".no_future_deliveries"), anchor: "future_deliveries" %>

  <% if @future_baskets.provisionally_absent.any? %>
    <div class="footnote">
      <span class="footnote-mark">*</span>
      <p><%= t(".provisionally_absent_explanation_html") %></p>
    </div>
  <% end %>
</section>

<section id="past_deliveries">
  <h2><%= t(".past_deliveries") %></h2>

  <%= render "baskets_list", baskets: @past_baskets, empty_text: t(".no_past_deliveries"), anchor: "past_deliveries" %>
</section>
