<%# locals: (baskets:, empty_text:, anchor:, home_delivery_cta_basket: nil) %>

<% if baskets.empty? %>
  <p class="nocontent"><%= empty_text %></p>
<% else %>
  <% limit = params[:"all_#{anchor}"] ? 10_000 : 4 %>
  <ul class="list">
    <% baskets.first(limit).each do |basket| %>
      <li class="list-item">
        <%= render partial: "members/baskets/basket", object: basket, locals: { home_delivery_cta_basket: home_delivery_cta_basket } %>
      </li>
    <% end %>
  </ul>
  <%= render partial: "members/shared/show_all_button", locals: { collection: baskets, limit: limit, anchor: anchor } %>
<% end %>
