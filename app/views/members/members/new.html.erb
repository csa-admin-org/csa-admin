<h1 class="form-page-title"><%= t(".title") %></h1>

<div class="form-lead">
  <p>
    <%= Current.org.member_form_subtitle? ? Current.org.member_form_subtitle : t(".subtitle") %>
  </p>
</div>

<div class="form-wrap" data-controller="form-scroll-to-error">
  <% if @member.errors.of_kind?(:emails, :taken) %>
    <div class="form-alert" role="alert">
      <strong class="form-alert-title">
        <%= @member.emails_array.many? ? t(".emails_taken") : t(".email_taken") %>
      </strong>

      <span class="form-alert-text"><%= t(".email_taken_hint") %></span>
    </div>
  <% end %>

  <%= simple_form_for @member,
    url: members_member_path,
    data: {
      turbo: false,
      controller: "form-pricing form-section-nav",
      "form-pricing-url-value": new_members_member_url,
      "form-section-nav-navigation-label-value": t("accessibility.members.form_section_navigation"),
      "form-section-nav-section-label-value": t("accessibility.members.form_section_number", number: "%{number}")
    } do |f| %>
    <div class="form-sections">
      <div
        class="print-break-page"
        aria-label="<%= Member.human_attribute_name(:contact) %>"
        data-form-section-nav-target="section"
      >
        <legend class="form-legend">
          <%= Member.human_attribute_name(:contact) %>
        </legend>

        <div class="form-fields">
          <%= f.input :name, label: t(".name") %>
          <%= f.input :street, required: true %>

          <div class="form-zipcity">
            <%= f.input :zip, required: true, input_html: { size: 6, maxlength: 6 }, wrapper_html: { class: "form-zip" } %>
            <%= f.input :city, required: true, wrapper_html: { class: "form-grow" } %>
          </div>

          <%= f.input :country_code, required: true, as: :select, collection: countries_collection %>
          <%= f.input :emails, as: :string, required: true %>
          <%= f.input :phones, as: :string, required: true %>
        </div>
      </div>

      <%= render "members/members/form_modes/#{Current.org.member_form_mode}", f: f, member: @member %>

      <div>
        <legend class="form-legend">
          <%= t(".more_info") %>
        </legend>

        <div class="form-fields">
          <% unless Current.org.member_profession_form_mode == "hidden" %>
            <%= f.input :profession, hint: true, required: (Current.org.member_profession_form_mode == "required") %>
          <% end %>

          <% unless Current.org.member_come_from_form_mode == "hidden" %>
            <%= f.input :come_from, as: :text, required: (Current.org.member_come_from_form_mode == "required"), input_html: { rows: 1 } %>
          <% end %>

          <%= f.input :note, as: :text, label: t(".note"), input_html: { rows: 2 } %>
        </div>
      </div>

      <% if Current.org.terms_of_service? %>
        <div class="check_boxes">
          <div class="checkbox">
            <%= f.input :terms_of_service, as: :boolean, label: terms_of_service_label %>
          </div>
        </div>
      <% end %>

      <%= cap_token_field %>

      <%= tag.div class: "actions form-submit print-hidden", data: cap_submit_tooltip_data do %>
        <%= button_tag type: "submit", data: cap_submit_tooltip_target_data do %>
          <%= icon "check", class: "icon-inline-action" %>
          <span><%= t(".submit") %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "pricing" do %>
    <% if params[:member].present? %>
      <%= render partial: "members/members/pricing", locals: { params: member_params.to_unsafe_h } %>
    <% end %>
  <% end %>
</div>
