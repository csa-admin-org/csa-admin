<%# locals: (disabled: false) %>
<div
  class="member-depot-map-panel print-hidden <%= " disabled" if disabled %>"
  data-form-disabler-target="label"
>
  <p class="depot-map-hint">
    <%= t("maps.registration_depot_map.hint") %>
  </p>

  <div
    class="depot-map"
    role="region"
    aria-label="<%= t("maps.registration_depot_map.title") %>"
    data-depot-map-target="map"
  ></div>
</div>
