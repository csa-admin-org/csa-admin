<h1>
  <span class="emoji">👋🏻</span>
  <%= t(".title", email: ellipsisize(email)) %>
</h1>

<div class="subscribe-back">
  <p class="subscribe-copy"><%= t(".subscribe_back") %></p>
  <%= button_to t(".subscribe"), members_subscribe_newsletter_path(params[:token]), form: { class: "subscribe-form" }, class: "subscribe-btn", data: { turbo: false } %>
</div>
