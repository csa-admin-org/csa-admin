<h1><%= t(".billing") %></h1>

<section>
  <%= render "members/billing/summary", membership: @membership %>
  <%= render "members/billing/membership" %>
</section>

<% if @open_invoices.any? %>
  <section>
    <h2><%= t(".open_invoices") %></h2>

    <ul class="invoices">
      <% @open_invoices.each do |invoice| %>
        <li class="invoice is-open">
          <%= render partial: "members/billing/line", locals: { object: invoice } %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section id="billing_history">
  <h2><%= t(".history") %></h2>

  <% if @billing_history.empty? %>
    <p class="nocontent"><%= t(".no_billing_history") %></p>
  <% else %>
    <ul class="invoices">
      <% limit = params[:all_billing_history] ? 10_000 : 15 %>

      <% @billing_history.first(limit).each do |object| %>
        <li
          class="invoice <%= " is-canceled" if object.respond_to?(:canceled?) && object.canceled? %>"
          data-hover-id="<%= (object.is_a?(Invoice) && object.entity ? dom_id(object.entity) : nil) %>"
        >
          <%= render partial: "members/billing/line", locals: { object: object } %>
        </li>
      <% end %>
    </ul>
    <%= render partial: "members/shared/show_all_button", locals: { collection: @billing_history, limit: limit, anchor: "billing_history" } %>
  <% end %>

  <p class="billing-note">
    <%= t(".explanation") %>
  </p>

  <%= render "members/billing/sepa" %>
</section>
