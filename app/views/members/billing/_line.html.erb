<span class="invoice-date"><%= l(object.date, format: :number) %></span>

<% case object %>
<% when Invoice %>
  <span class="invoice-body">
    <span>
      <%= t(".invoice_info_html", document_name: object.document_name, id: object.id, type: display_entity(object, link: false)) %>
    </span>

    <span>
      <%= link_to rails_blob_path(object.pdf_file, disposition: "attachment") do %>
        <%= icon "file-down", class: "icon-inline" %>
      <% end %>
    </span>
  </span>
  <span class="invoice-amount"><%= ccur(object, :amount) %></span>
<% when Payment %>
  <span class="invoice-body is-payment">
    <% if object.amount.positive? %>
      <% if object.invoice %>
        <%= t(".payment_info_html", invoice_id: object.invoice_id, invoice_type: display_entity(object.invoice, link: false)) %>
      <% else %>
        <%= t(".manual_payment_info") %>
      <% end %>
    <% else %>
      <%= t(".refund_info") %>
    <% end %>
  </span>
  <span class="invoice-amount">
    <%= cur(-object.amount, currency_code: object.currency_code) %>
  </span>
<% end %>
