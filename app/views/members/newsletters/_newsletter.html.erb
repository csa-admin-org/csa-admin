<% newsletter = delivery.source %>

<li class="newsletter-item">
  <details>
    <summary class="newsletter-summary">
      <div>
        <h3 class="newsletter-title">
          <%= delivery.subject %>
        </h3>

        <span class="newsletter-date"><%= l newsletter.sent_at.to_date %></span>
      </div>
    </summary>

    <div class="newsletter-body">
      <%= turbo_frame_tag delivery,
        src: members_newsletter_delivery_path(delivery),
        loading: "lazy", target: "_top" do %>
        <div class="mail_preview">
          <div class="newsletter-loading">
            <%= render "shared/spinner" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
</li>
