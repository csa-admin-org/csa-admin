<% deliveries = BasketContent.coming_deliveries_missing_contents_from(from_delivery) %>

<%= form_with url: duplicate_all_basket_contents_path, method: :post, class: "sidebar_form" do |f| %>
  <%= f.hidden_field :from_delivery_id, value: from_delivery.id %>

  <p><%= t(".text", from: I18n.l(from_delivery.date, format: :long)) %></p>

  <div class="form-group">
    <%= f.select :to_delivery_id, deliveries.map { |d| [ I18n.l(d.date, format: :medium), d.id ] }, {}, { class: "btn is-compact text-sm" } %>
  </div>

  <div class="cluster is-end">
    <button type="submit" class="btn btn-sm">
      <%= icon("square-arrow-right-exit", class: "icon-4") %>
      <%= t(".button") %>
    </button>
  </div>
<% end %>
