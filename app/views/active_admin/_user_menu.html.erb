<div
  class="admin-user-menu"
  data-controller="tooltip"
  data-tooltip-dismissible-value="true"
  data-tooltip-placement-value="bottom-end"
>
  <button
    type="button"
    id="user-menu-button"
    class="admin-header-action"
    data-tooltip-target="trigger"
    data-action="click->tooltip#toggle"
    aria-controls="user-menu"
    aria-expanded="false"
  >
    <%= icon "circle-user-round", class: "admin-header-action-icon is-lg" %>
  </button>

  <div
    id="user-menu"
    data-tooltip-target="content"
    class="admin-menu"
    aria-labelledby="user-menu-button"
  >
    <ul class="admin-menu-list">
      <% if current_active_admin_user? %>
        <li>
          <%= auto_link current_active_admin_user, class: "admin-menu-link is-user" %>
        </li>
        <% language = current_active_admin_user.language %>
        <li>
          <%= link_to edit_admin_path(current_active_admin_user, anchor: "languages"), class: "admin-menu-link" do %>
            <%= icon "languages", class: "admin-menu-icon" %>

            <span><%= t("languages.#{language}") %></span>
          <% end %>
        </li>
        <% theme = current_active_admin_user.theme %>
        <% theme_icon = HasTheme::THEME_ICONS.fetch(theme) %>
        <li>
          <%= link_to edit_admin_path(current_active_admin_user, anchor: "theme"), class: "admin-menu-link" do %>
            <%= icon theme_icon, class: "admin-menu-icon" %>
            <span><%= t("themes.#{theme}") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="admin-menu-logout-wrap">
      <%= link_to auto_logout_link_path, class: "admin-menu-logout", data: { method: :delete } do %>
        <%= t("active_admin.logout") %>
        <%= icon "log-out", class: "admin-menu-logout-icon" %>
      <% end %>
    </div>
  </div>
</div>
