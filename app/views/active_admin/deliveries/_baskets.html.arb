# frozen_string_literal: true

require "ostruct"

bs_names = counts.basket_sizes.map(&:name).map { |name| content_tag :span, name, class: "is-nowrap" }
show_shop_orders = feature?("shop") && delivery.shop_open && scope != :absent
counts_by_depot = counts.all
summary_sections = delivery.basket_summary_sections.filter_map do |section|
  rows = section.rows.filter_map do |row|
    row_counts = counts_by_depot.select { |count| row.depot_ids.include?(count.depot_id) }
    basket_count = row_counts.sum(&:count)
    shop_orders_count = row_counts.sum(&:shop_orders_count)
    next if basket_count.zero? && (!show_shop_orders || shop_orders_count.zero?)

    baskets_count = counts.basket_sizes.each_with_index.map do |_basket_size, index|
      row_counts.sum { |count| count.basket_sizes_count[index] }
    end.join(" / ")

    OpenStruct.new(
      title: row.title,
      count: basket_count,
      baskets_count: baskets_count,
      shop_orders_count: shop_orders_count)
  end
  rows if rows.any?
end

attrs = {}
if authorized?(:update, Depot)
  attrs[:tbody_html] = { data: { controller: "sortable" } }
  attrs[:row_html] = ->(bc) {
    { data: { "sortable-update-url" => "/depots/#{bc.depot_id}/move_to?delivery_id=#{delivery.id}" } }
  }
end

if counts.present?
  table_for(counts.all, **attrs) do
    column(Depot.model_name.human, class: "col-name") { |bc| link_to bc.depot.name, depot_path(bc.depot, delivery_id: delivery.id) }
    if show_shop_orders
      column link_to(t("shop.title"), shop_orders_path(q: { _delivery_gid_eq: delivery.gid })), :shop_orders_count, class: "text-right"
    end
    if counts.sum.positive?
      column Basket.model_name.human(count: 2), :count, class: "text-right "
      column "#{bs_names.join("&nbsp;/ ")}".html_safe, :baskets_count, class: "text-right"
    end
  end

  summary_sections.each_with_index do |rows, index|
    table_for rows, class: "delivery-summary" do
      column nil, :title, class: "col-name"
      if show_shop_orders
        column nil, :shop_orders_count, class: "text-right"
      end
      if counts.sum.positive?
        column nil, :count, class: "text-right"
        column nil, :baskets_count, class: "text-right"
      end
    end
  end

  table_for nil, class: "delivery-totals data-no-hover" do
    column(nil, :title, class: "col-name text-lg") { t("active_admin.page.index.total", number: "") }
    if show_shop_orders
      column(class: "text-right text-lg") { counts.sum_shop_orders }
    end
    if counts.sum.positive?
      column(class: "text-right text-lg") { counts.sum }
      column(class: "text-right text-lg") { counts.sum_detail }
    end
  end
end

if BasketComplement.kept.any?
  div class: "dashboard-section" do
    if complement_counts.any?
      table_for complement_counts, class: "" do
        column BasketsBasketComplement.model_name.human, :title, class: "col-name"
        if show_shop_orders
          column link_to(t("shop.title"), shop_orders_path(q: { _delivery_gid_eq: delivery.gid })), :shop_orders_count, class: "text-right"
        end
        column Membership.model_name.human(count: 2), :memberships_count, class: "text-right"
        column t("active_admin.page.index.total", number: ""), :count, class: "text-right font-bold"
      end
    else
      em t("delivery.no_basket_complements"), class: "missing-data"
    end
  end
end
