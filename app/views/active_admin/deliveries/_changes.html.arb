# frozen_string_literal: true

changes = Delivery::Changes.new(delivery)
return unless changes.any?

details class: "arrow-details" do
  summary class: "cluster is-end is-muted" do
    text_node t("active_admin.page.index.changes_count", count: changes.entries.size)
  end
  div do
    table class: "data-table" do
      thead do
        tr do
          th Member.model_name.human(count: 2), class: "col-name"
          th I18n.t("delivery.changes")
        end
      end
      tbody do
        changes.entries_by_depot.each do |depot_name, entries|
          tr class: "change-depot-row" do
            td depot_name, colspan: "2", class: "change-depot-name"
          end
          entries.each do |entry|
            dimmed = entry.ended? || entry.absent?
            row_class = "dotted-row"
            row_class += " muted-data" if dimmed
            tr class: row_class do
              td link_to(entry.member.name, entry.member), class: "col-name"
              td do
                text_node entry.html_description
              end
            end
          end
        end
      end
    end
  end
end
