<div class="panel">
  <div class="panel-title">
    <div class="panel-title-heading">
      <span class="panel-title-icon">
        <%= icon("message-square-text", class: "icon-5") %>
      </span>

      <h3><%= I18n.t "active_admin.comments.title_content" %></h3>
      <span class="panel-title-count"><%= comments.total_count %></span>
    </div>
  </div>

  <div class="panel-body">
    <% if comments.any? %>
      <div class="comment-list">
        <% comments.each do |comment| %>
          <div
            class="comment-item"
            id="<%= dom_id(comment, :active_admin) %>"
            data-test-comment-container
          >
            <div class="comment-meta">
              <span class="font-semibold">
                <%= comment.author ? auto_link(comment.author) : I18n.t("active_admin.comments.author_missing") %>
              </span>

              <span class="comment-time">
                <%= pretty_format comment.created_at %>
              </span>

              <% if authorized?(ActiveAdmin::Auth::DESTROY, comment) %>
                <div class="comment-delete">
                  <%= link_to I18n.t("active_admin.comments.delete"), url_for_comments(comment.id), method: :delete, data: { confirm: I18n.t("active_admin.comments.delete_confirmation") }, class: "btn btn-sm" %>
                </div>
              <% end %>
            </div>

            <div class="comment-body">
              <%= simple_format(comment.body) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="missing-data">
        <%= I18n.t("active_admin.comments.no_comments_yet") %>
      </div>
    <% end %>

    <% if authorized?(ActiveAdmin::Auth::NEW, ActiveAdmin::Comment) %>
      <%= active_admin_form_for(ActiveAdmin::Comment.new, url: comment_form_url, html: { class: "comment-form", novalidate: false }) do |f|
        ol class: "list-none" do
          f.input :resource_type, as: :hidden, input_html: { value: ActiveAdmin::Comment.resource_type(resource) }
          f.input :resource_id, as: :hidden, input_html: { value: resource.id }
          f.input :body, label: false, input_html: { size: "80x2", required: true }, wrapper_html: { class: "comment-body-input" }
        end
        div class: "comment-form-actions" do
          f.action :submit, label: I18n.t("active_admin.comments.add"), button_html: { class: "btn btn-sm" }, icon: "message-circle-check", icon_class: "icon-4"
        end
      end %>
    <% end %>
  </div>
</div>
