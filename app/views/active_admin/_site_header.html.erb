<div class="admin-bar">
  <div class="admin-bar-inner" data-controller="nav-toggle">
    <div class="admin-menu-toggle-wrap">
      <button
        type="button"
        class="admin-menu-toggle"
        data-action="nav-toggle#toggle"
        aria-expanded="false"
      >
        <%= icon "menu", class: "admin-menu-toggle-icon" %>

        <span class="sr-only">
          <%= t("accessibility.active_admin.open_main_menu") %>
        </span>
      </button>
    </div>

    <nav class="admin-nav" id="navbar-dropdown">
      <ul class="admin-nav-list">
        <% current_menu.items(self).each do |item| %>
          <% children = item.items(self).presence %>
          <% item_label = menu_label_with_badge(item) %>
          <% plain_label = item.label(self) %>

          <li class="admin-nav-item" data-item-id="<%= item.id %>">
            <% if children %>
              <% first_child = children.first %>
              <% parent_quick_access = item.id != "other" && first_child&.url(self) %>
              <% parent_current = children.any? { |child| current_menu_item?(child) } %>
              <% parent_classes = "admin-nav-parent#{' is-current' if parent_current}" %>
              <% if parent_quick_access %>
                <%= link_to first_child.url(self),
                  id: "dropdownHoverButton-#{item.id}",
                  class: parent_classes,
                  **(current_menu_item?(first_child) ? { "aria-current" => "page" } : {}) do %>
                  <%= item_label %>
                  <%= icon "chevron-down", class: "admin-nav-chevron" %>
                <% end %>
              <% else %>
                <button
                  id="dropdownHoverButton-<%= item.id %>"
                  class="<%= parent_classes %>"
                >
                  <%= item_label %>
                  <%= icon "chevron-down", class: "admin-nav-chevron" %>
                </button>
              <% end %>
              <%= tag.ul(
                id: item.id,
                role: "list",
                class: "admin-nav-dropdown",
                "aria-labelledby": "dropdownHoverButton-#{item.id}",
                data: item.html_options[:data].to_h
              ) do %>
                <% children.each do |child| %>
                  <li data-item-id="<%= child.id %>">
                    <%= link_to child.label(self), child.url(self), child.html_options.merge(class: "admin-nav-dropdown-link#{' is-current selected' if current_menu_item?(child)}") %>
                  </li>
                <% end %>
              <% end %>
              <div class="admin-nav-mobile-heading">
                <%= plain_label %>
              </div>
              <ul class="admin-nav-mobile-list">
                <% children.each do |child| %>
                  <li data-item-id="<%= child.id %>">
                    <%= link_to menu_label_with_badge(child, badge_class: "menu-inline-badge"), child.url(self), child.html_options.merge(class: "admin-nav-dropdown-link#{' is-current selected' if current_menu_item?(child)}") %>
                  </li>
                <% end %>
              </ul>
            <% elsif url = item.url(self) %>
              <%= link_to item_label, url, item.html_options.merge(class: "admin-nav-link#{' is-current' if current_menu_item?(item)}").merge(current_menu_item?(item) ? { "aria-current" => "page" } : {}) %>
            <% else %>
              <%= item_label %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>

    <div class="admin-bar-actions">
      <%= render "search/modal" %>

      <% if Update.unread_count(current_active_admin_user).positive? %>
        <%= link_to updates_path,
          class: "admin-header-action",
          title: t(".updates"),
          data: { turbo_prefetch: "false" } do %>
          <%= icon "gift" %>

          <div class="admin-header-unread"></div>
        <% end %>
      <% end %>

      <%= link_to support_tickets_path,
        class: "admin-header-action",
        title: t(".support"),
        data: { turbo_prefetch: "false" } do %>
        <%= icon "life-buoy" %>
      <% end %>

      <%= link_to analytics_path,
        class: "admin-header-action",
        title: t(".analytics"),
        data: { turbo_prefetch: "false" } do %>
        <%= icon "chart-no-axes-combined" %>
      <% end %>

      <%= link_to handbook_path,
        class: "admin-header-action",
        title: t(".handbook") do %>
        <%= icon "book-open" %>
      <% end %>

      <% if can?(:read, Organization) %>
        <%= link_to organization_path, class: "admin-header-action" do %>
          <%= icon "sliders-horizontal" %>
        <% end %>
      <% end %>

      <%= render "active_admin/user_menu" %>
    </div>
  </div>
</div>
