<div class="invoice-preview">
  <div class="invoice-preview-spinner">
    <%= render "shared/spinner" %>
  </div>

  <% if invoice.pdf_current? && !invoice.processing? %>
    <%= image_tag invoice.pdf_file.preview(resize_to_limit: [ 2000, 2000 ]), alt: "", class: "invoice-preview-page" %>
  <% end %>
</div>
