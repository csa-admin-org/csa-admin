<% ready = invoice.pdf_current? && !invoice.processing? %>

<div
  class="invoice-preview <%= "is-pending" unless ready %>"
  <% if ready %>
    data-controller="invoice-preview"
    data-invoice-preview-src-value="<%= pdf_invoice_path(invoice) %>"
    data-invoice-preview-worker-value="<%= asset_path("pdfjs-dist-worker.js") %>"
  <% end %>
>
  <% if ready %>
    <canvas class="invoice-preview-page" data-invoice-preview-target="canvas"></canvas>
  <% end %>

  <div class="invoice-preview-spinner" data-invoice-preview-target="spinner">
    <%= render "shared/spinner" %>
  </div>
</div>
