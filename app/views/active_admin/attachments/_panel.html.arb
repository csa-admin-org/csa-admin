panel Attachment.model_name.human(count: 2), icon: "paperclip" do
  if attachments.any?
    div class: "panel-inset is-flush" do
      ul class: "disc-list is-outside stack is-snug" do
        attachments.map { |a| display_attachment(a.file) }.each do |a|
          li { a }
        end
      end
    end
  else
    div(class: "missing-data") { t("active_admin.empty") }
  end
end
