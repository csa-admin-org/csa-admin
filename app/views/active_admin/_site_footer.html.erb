<footer class="admin-footer">
  <ul class="admin-footer-nav" role="group">
    <li>
      <%= link_to support_path, class: "action-item-button admin-footer-nav-link is-start" do %>
        <%= icon "life-buoy", class: "admin-footer-nav-icon" %>
        <%= t(".support") %>
      <% end %>
    </li>

    <li>
      <%= link_to analytics_path, class: "action-item-button admin-footer-nav-link is-middle", data: { turbo_prefetch: "false" } do %>
        <%= icon "chart-no-axes-combined", class: "admin-footer-nav-icon" %>
        <%= t(".analytics") %>
      <% end %>
    </li>

    <li>
      <%= link_to handbook_path, class: "action-item-button admin-footer-nav-link is-end" do %>
        <%= icon "book-open", class: "admin-footer-nav-icon" %>
        <%= t(".handbook") %>
      <% end %>
    </li>
  </ul>

  <div class="admin-footer-updates">
    <%= link_to updates_path, class: "admin-footer-updates-link", data: { turbo_prefetch: false } do %>
      <%= icon "gift", class: "admin-footer-updates-icon" %>
      <%= t(".updates") %>

      <% if Update.unread_count(current_active_admin_user).positive? %>
        <div class="admin-footer-unread"></div>
      <% end %>
    <% end %>
  </div>

  <div class="admin-credit">
    <%= link_to csa_admin_website_url, class: "admin-credit-link" do %>
      <%= icon "logo", class: "admin-credit-icon" %> CSA Admin
    <% end %>
  </div>
</footer>
