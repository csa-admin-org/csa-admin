<% if flash_messages.present? %>
  <div class="admin-flashes">
    <% flash_messages.each do |type, message| %>
      <% if type == "error" %>
        <div
          class="admin-flash admin-flash--error"
          aria-label="<%= t("accessibility.active_admin.flash.error") %>"
        >
          <%= icon "circle-alert", class: "admin-flash-icon" %>
          <%= message %>
        </div>
      <% elsif type == "alert" %>
        <div
          class="admin-flash admin-flash--alert"
          aria-label="<%= t("accessibility.active_admin.flash.alert") %>"
        >
          <%= icon "info", class: "admin-flash-icon" %>
          <%= message %>
        </div>
      <% elsif type == "notice" %>
        <div
          class="admin-flash admin-flash--notice"
          aria-label="<%= t("accessibility.active_admin.flash.notice") %>"
        >
          <%= icon "info", class: "admin-flash-icon" %>
          <%= message %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
