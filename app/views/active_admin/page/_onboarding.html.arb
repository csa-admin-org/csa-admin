# frozen_string_literal: true

div class: "onboarding" do
  div class: "onboarding-card" do
    h1 class: "onboarding-title" do
      t(".welcome")
    end
    panel t(".getting_started"), action: handbook_icon_link("getting_started") do
      div class: "onboarding-body" do
        para t(".intro_html")

        div class: "onboarding-list" do
          ul class: "onboarding-steps" do
            li do
              if Delivery.any?
                a href: deliveries_path do
                  span class: "onboarding-step is-faint is-struck" do
                    span icon("clipboard-check", class: "icon-7")
                    span t(".create_deliveries")
                  end
                end
              else
                a href: new_delivery_path do
                  span class: "onboarding-step" do
                    span icon("clipboard", class: "icon-7")
                    span t(".create_deliveries")
                  end
                end
              end
            end
            if Current.org.member_form_mode == "membership"
              li do
                if BasketSize.kept.any?
                  a href: basket_sizes_path do
                    span class: "onboarding-step is-faint is-struck" do
                      span icon("clipboard-check", class: "icon-7")
                      span t(".create_basket_sizes")
                    end
                  end
                else
                  a href: new_basket_size_path do
                    span class: "onboarding-step" do
                      span icon("clipboard", class: "icon-7")
                      span t(".create_basket_sizes")
                    end
                  end
                end
              end
            end
            li do
              if Depot.kept.any?
                a href: depots_path do
                  span class: "onboarding-step is-faint is-struck" do
                    span icon("clipboard-check", class: "icon-7")
                    span t(".create_depots")
                  end
                end
              else
                a href: new_depot_path do
                  span class: "onboarding-step" do
                    span icon("clipboard", class: "icon-7")
                    span t(".create_depots")
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end
