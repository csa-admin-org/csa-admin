<p><%= t(".greeting") %></p>

<p><%= t(".still_remaining_paragraph") %></p>
<ul>
  {% if pending_memberships.size > 0 %}
  <li>
    <%= t(".pending_memberships_label") %> <a href={{ pending_action_url }}>{{ pending_memberships.size }}</a>
  </li>
  {% endif %}

  {% if opened_memberships.size > 0 %}
  <li>
    <%= t(".opened_memberships_label") %> <a href={{ opened_action_url }}>{{ opened_memberships.size }}</a>
  </li>
  {% endif %}
</ul>

<br/>
<p><%= t(".check_before_paragraph") %></p>

{% button action_url %}
  <%= t(".memberships_button") %>
{% endbutton %}
