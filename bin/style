#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage:
#   bin/style                  # check everything
#   bin/style path [path...]   # check specific paths
#   bin/style check [path...]  # same as default
#   bin/style fix [path...]    # auto-fix / format
#
# Runs Style::Runner directly (no Rails boot).

args = ARGV.dup
mode =
  case args.first
  when "fix"
    args.shift
    :fix
  when "check"
    args.shift
    :check
  else
    :check
  end

require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "style"

Style::Runner.new(mode: mode, paths: args).call
