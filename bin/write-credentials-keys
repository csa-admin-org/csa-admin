#!/usr/bin/env ruby
# frozen_string_literal: true

# Materialize Rails credentials key files from Cloud Agent secrets.
#
# Cursor injects secrets as process env vars. Rails only understands
# RAILS_MASTER_KEY, which overrides key files for every environment, so we
# keep distinct RAILS_PROD_MASTER_KEY / RAILS_TEST_MASTER_KEY secrets and write:
#   config/master.key              <- RAILS_PROD_MASTER_KEY
#   config/credentials/test.key    <- RAILS_TEST_MASTER_KEY

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

FileUtils.chdir APP_ROOT do
  prod_key = ENV["RAILS_PROD_MASTER_KEY"].to_s.strip
  test_key = ENV["RAILS_TEST_MASTER_KEY"].to_s.strip

  if prod_key.empty? && test_key.empty?
    warn "bin/write-credentials-keys: neither RAILS_PROD_MASTER_KEY nor RAILS_TEST_MASTER_KEY is set; skipping"
    exit 0
  end

  unless prod_key.empty?
    File.write("config/master.key", prod_key)
    File.chmod(0o600, "config/master.key")
    puts "Wrote config/master.key from RAILS_PROD_MASTER_KEY"
  end

  unless test_key.empty?
    FileUtils.mkdir_p("config/credentials")
    File.write("config/credentials/test.key", test_key)
    File.chmod(0o600, "config/credentials/test.key")
    puts "Wrote config/credentials/test.key from RAILS_TEST_MASTER_KEY"
  end
end

# Callers must also clear RAILS_MASTER_KEY in their own process/shell: Rails
# prefers that env var over the key files. `bin/setup` does this after invoke;
# Cursor install scripts should `unset RAILS_MASTER_KEY` after this command.
