#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"

APP_ROOT = File.expand_path("..", __dir__)
HERB_NPM_PACKAGES = %w[@herb-tools/linter @herb-tools/formatter].freeze

def system!(*args, **kwargs)
  system(*args, **kwargs, exception: true)
end

def mise_ruby_version
  File.read("mise.toml")[/^ruby\s*=\s*"([^"]+)"/, 1] or
    abort "Could not read ruby version from mise.toml"
end

def gemfile_cooldown
  # `--cooldown` and `bundle config cooldown` outrank the Gemfile source keyword.
  # Pass the Gemfile value so a user-level cooldown cannot change this update.
  File.read("Gemfile")[/^source\s+".*",\s*cooldown:\s*(\d+)\s*$/, 1] or
    abort "Could not read source cooldown from Gemfile"
end

def sync_dockerfile_ruby!
  ruby = mise_ruby_version
  path = "Dockerfile"
  contents = File.read(path)

  unless contents.match?(/^ARG RUBY_VERSION=/)
    abort "Could not find ARG RUBY_VERSION in Dockerfile"
  end

  updated = contents.sub(/^ARG RUBY_VERSION=.*$/, "ARG RUBY_VERSION=#{ruby}")
  if updated == contents
    puts "Dockerfile RUBY_VERSION already #{ruby}"
  else
    File.write(path, updated)
    puts "Synced Dockerfile RUBY_VERSION → #{ruby}"
  end
end

def herb_gem_version
  out = IO.popen(
    [ "bundle", "exec", "ruby", "-e", 'print Gem.loaded_specs.fetch("herb").version' ],
    err: %i[child out],
    &:read
  )
  abort "Failed to resolve herb gem version:\n#{out}" unless $?.success?
  abort "herb gem version was empty" if out.strip.empty?

  out.strip
end

def align_herb_npm_to_gem!
  version = herb_gem_version
  package = JSON.parse(File.read("package.json"))
  deps = package.fetch("devDependencies")
  changed = false

  HERB_NPM_PACKAGES.each do |name|
    desired = "^#{version}"
    current = deps[name]
    next if current == desired

    puts "Aligning #{name}: #{current.inspect} → #{desired}"
    deps[name] = desired
    changed = true
  end

  if changed
    File.write("package.json", JSON.pretty_generate(package) + "\n")
    system! "bin/oxfmt", "package.json"
    system! "bin/aube", "install"
  else
    puts "Herb npm packages already aligned to gem #{version}"
  end

  HERB_NPM_PACKAGES.each do |name|
    installed = JSON.parse(File.read(File.join("node_modules", name, "package.json"))).fetch("version")
    next if installed == version

    abort "Installed #{name}@#{installed} does not match herb gem #{version}"
  end
end

def upgrade_herb_yml!
  # Bumps .herb.yml version; enables clean new rules, disables offending ones.
  system! "bin/herb", "lint", "--upgrade"
end

def restore_chartjs_umd!
  # importmap update rewrites chart.js from jspm. That ESM entry imports an unpinned
  # helpers chunk and never assigns globalThis.Chart, which analytics expects.
  version = File.read("config/importmap.rb")[/^pin "chart\.js".*# @(\d+\.\d+\.\d+)/, 1] or
    abort "Could not read chart.js version from config/importmap.rb"
  url = "https://unpkg.com/chart.js@#{version}/dist/chart.umd.min.js"
  path = "vendor/javascript/chart.js.js"
  download = "#{path}.download"
  system! "curl", "-fsSL", "-o", download, url
  body = File.read(download)
  File.delete(download)
  # The UMD build inlines @kurkle/color and only mentions it in a copyright banner.
  # Match import syntax, not the "Please import and register" warning string.
  esm = body.match?(/\bimport[{(]/) || body.include?('from"../_/') || body.include?('from"@kurkle/color"')
  unless body.include?("window.Chart=") && !esm
    abort "Chart.js download from #{url} is not the self-contained UMD build"
  end

  File.write(path, "// chart.js@#{version} downloaded from #{url}\n\n#{body}")
  Dir.glob("vendor/javascript/@kurkle*") { |entry| FileUtils.rm_rf(entry) }
  importmap = File.read("config/importmap.rb")
  cleaned = importmap.gsub(/^pin "@kurkle\/color".*(?:\n|\z)/, "")
  File.write("config/importmap.rb", cleaned) if cleaned != importmap
end

FileUtils.chdir APP_ROOT do
  # Update local toolchains and dependency lockfiles.
  # Review the diff afterward — this is intentionally non-conservative.

  puts "== Updating mise =="
  system! "mise", "self-update", "-y"

  puts "\n== Upgrading mise tools =="
  system! "mise", "upgrade"

  puts "\n== Syncing Dockerfile Ruby version =="
  sync_dockerfile_ruby!

  cooldown = gemfile_cooldown
  puts "\n== Updating gems (cooldown: #{cooldown} days) =="
  system! "bundle", "update", "--all", "--cooldown", cooldown

  puts "\n== Updating JS packages =="
  system! "bin/aube", "update"

  puts "\n== Aligning Herb npm packages to gem =="
  align_herb_npm_to_gem!

  puts "\n== Upgrading .herb.yml ruleset =="
  upgrade_herb_yml!

  puts "\n== Updating importmap pins =="
  system! "bin/importmap", "update"

  puts "\n== Restoring Chart.js UMD pin =="
  restore_chartjs_umd!
end
