#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "tempfile"
require "tmpdir"

APP_ROOT = File.expand_path("..", __dir__)
HERB_NPM_PACKAGES = %w[@herb-tools/linter @herb-tools/formatter].freeze

def system!(*args, **kwargs)
  system(*args, **kwargs, exception: true)
end

def mise_ruby_version
  File.read("mise.toml")[/^ruby\s*=\s*"([^"]+)"/, 1] or
    abort "Could not read ruby version from mise.toml"
end

def gemfile_cooldown
  # `--cooldown` and `bundle config cooldown` outrank the Gemfile source keyword.
  # Pass the Gemfile value so a user-level cooldown cannot change this update.
  File.read("Gemfile")[/^source\s+".*",\s*cooldown:\s*(\d+)\s*$/, 1] or
    abort "Could not read source cooldown from Gemfile"
end

def update_github_actions!(cooldown)
  # pinact updates SHA pins to the newest release at least `cooldown` days old.
  # Config min_age filters candidates. CLI --min-age also verifies current pins
  # and exits 2 when one is still inside the window, which would abort this
  # script after it had just written that pin.
  config = nil
  config = Tempfile.create([ "pinact", ".yaml" ])
  config.write(<<~YAML)
    version: 3
    min_age:
      value: #{cooldown}
  YAML
  config.flush

  system! "mise", "install", "pinact"
  system! "mise", "exec", "--", "pinact", "run", "--update", "-c", config.path
ensure
  if config
    config.close
    File.unlink(config.path)
  end
end

def sync_dockerfile_ruby!
  ruby = mise_ruby_version
  %w[Dockerfile hotcell/Dockerfile].each do |path|
    contents = File.read(path)

    unless contents.match?(/^ARG RUBY_VERSION=/)
      abort "Could not find ARG RUBY_VERSION in #{path}"
    end

    updated = contents.sub(/^ARG RUBY_VERSION=.*$/, "ARG RUBY_VERSION=#{ruby}")
    if updated == contents
      puts "#{path} RUBY_VERSION already #{ruby}"
    else
      File.write(path, updated)
      puts "Synced #{path} RUBY_VERSION → #{ruby}"
    end
  end
end

def herb_gem_version
  out = IO.popen(
    [ "bundle", "exec", "ruby", "-e", 'print Gem.loaded_specs.fetch("herb").version' ],
    err: %i[child out],
    &:read
  )
  abort "Failed to resolve herb gem version:\n#{out}" unless $?.success?
  abort "herb gem version was empty" if out.strip.empty?

  out.strip
end

def align_herb_npm_to_gem!
  version = herb_gem_version
  package = JSON.parse(File.read("package.json"))
  deps = package.fetch("devDependencies")
  changed = false

  HERB_NPM_PACKAGES.each do |name|
    desired = "^#{version}"
    current = deps[name]
    next if current == desired

    puts "Aligning #{name}: #{current.inspect} → #{desired}"
    deps[name] = desired
    changed = true
  end

  if changed
    File.write("package.json", JSON.pretty_generate(package) + "\n")
    system! "bin/oxfmt", "package.json"
    system! "bin/aube", "install"
  else
    puts "Herb npm packages already aligned to gem #{version}"
  end

  HERB_NPM_PACKAGES.each do |name|
    installed = JSON.parse(File.read(File.join("node_modules", name, "package.json"))).fetch("version")
    next if installed == version

    abort "Installed #{name}@#{installed} does not match herb gem #{version}"
  end
end

def upgrade_herb_yml!
  # Bumps .herb.yml version; enables clean new rules, disables offending ones.
  system! "bin/herb", "lint", "--upgrade"
end

def restore_chartjs_umd!
  # importmap update rewrites chart.js from jspm. That ESM entry imports an unpinned
  # helpers chunk and never assigns globalThis.Chart, which analytics expects.
  version = File.read("config/importmap.rb")[/^pin "chart\.js".*# @(\d+\.\d+\.\d+)/, 1] or
    abort "Could not read chart.js version from config/importmap.rb"
  url = "https://unpkg.com/chart.js@#{version}/dist/chart.umd.min.js"
  path = "vendor/javascript/chart.js.js"
  download = "#{path}.download"
  system! "curl", "-fsSL", "-o", download, url
  body = File.read(download)
  File.delete(download)
  # The UMD build inlines @kurkle/color and only mentions it in a copyright banner.
  # Match import syntax, not the "Please import and register" warning string.
  esm = body.match?(/\bimport[{(]/) || body.include?('from"../_/') || body.include?('from"@kurkle/color"')
  unless body.include?("window.Chart=") && !esm
    abort "Chart.js download from #{url} is not the self-contained UMD build"
  end

  File.write(path, "// chart.js@#{version} downloaded from #{url}\n\n#{body}")
  Dir.glob("vendor/javascript/@kurkle*") { |entry| FileUtils.rm_rf(entry) }
  importmap = File.read("config/importmap.rb")
  cleaned = importmap.gsub(/^pin "@kurkle\/color".*(?:\n|\z)/, "")
  File.write("config/importmap.rb", cleaned) if cleaned != importmap
end

PDFJS_PREBUILT = {
  "build/pdf.mjs" => [ "vendor/javascript/pdfjs-dist.js", 'const version = "' ],
  "build/pdf.worker.mjs" => [ "vendor/javascript/pdfjs-dist-worker.js", "pdfjsVersion = " ]
}.freeze

def restore_pdfjs_prebuilt!
  # importmap update rewrites pdfjs-dist from jspm. That graph splits the
  # package into extra pins. The invoice preview needs Mozilla's prebuilt
  # modern-browsers modules, not that graph.
  version = File.read("config/importmap.rb")[/^pin "pdfjs-dist".*# @(\d+\.\d+\.\d+)/, 1] or
    abort "Could not read pdfjs-dist version from config/importmap.rb"
  url = "https://github.com/mozilla/pdf.js/releases/download/v#{version}/pdfjs-#{version}-dist.zip"

  Dir.mktmpdir("pdfjs-dist") do |dir|
    zip = File.join(dir, "dist.zip")
    system! "curl", "-fsSL", "-o", zip, url
    system! "unzip", "-qo", zip, *PDFJS_PREBUILT.keys, "-d", dir

    PDFJS_PREBUILT.each do |entry, (destination, marker)|
      install_pdfjs_module(File.join(dir, entry), destination, version, marker, url)
    end
  end

  Dir.glob("vendor/javascript/pdfjs-dist*") do |entry|
    next if entry.end_with?("pdfjs-dist.js", "pdfjs-dist-worker.js")

    FileUtils.rm_rf(entry)
  end
  restore_pdfjs_pins!(version)
end

def install_pdfjs_module(source, destination, version, marker, url)
  body = File.read(source).sub(/\A\/\/ pdfjs-dist@.*\n+/, "")
  body = body.sub(%r{\n*//# sourceMappingURL=.*\n?\z}, "\n")
  unless body.include?("#{marker}#{version}") && body.match?(/^export \{/)
    abort "PDF.js download from #{url} is not the #{version} prebuilt ESM module"
  end
  if body.match?(/^import[\s{]/)
    abort "PDF.js download from #{url} is not a self-contained prebuilt module"
  end

  File.write(destination, "// pdfjs-dist@#{version} prebuilt from #{url}\n\n#{body}")
end

def restore_pdfjs_pins!(version)
  display = %(pin "pdfjs-dist", to: "pdfjs-dist.js", preload: false # @#{version}\n)
  worker = %(pin "pdfjs-dist/worker", to: "pdfjs-dist-worker.js", preload: false # @#{version}\n)
  importmap = File.read("config/importmap.rb")
  cleaned = importmap.gsub(/^pin "pdfjs-dist"(?:,| #).*(?:\n|\z)/, display)
  cleaned = cleaned.gsub(/^pin "pdfjs-dist\/(?!worker").*(?:\n|\z)/, "")
  cleaned = cleaned.gsub(/^pin "pdfjs-dist\/worker".*(?:\n|\z)/, worker)
  cleaned = cleaned.sub(display, display + worker) unless cleaned.include?(worker)
  unless cleaned.include?(display) && cleaned.include?(worker)
    abort "Could not restore pdfjs-dist pins in config/importmap.rb"
  end

  File.write("config/importmap.rb", cleaned) if cleaned != importmap
end

FileUtils.chdir APP_ROOT do
  # Update local toolchains and dependency lockfiles.
  # Review the diff afterward — this is intentionally non-conservative.

  puts "== Updating mise =="
  system! "mise", "self-update", "-y"

  puts "\n== Upgrading mise tools =="
  system! "mise", "upgrade"

  cooldown = gemfile_cooldown
  puts "\n== Updating GitHub Actions (cooldown: #{cooldown} days) =="
  update_github_actions!(cooldown)

  puts "\n== Syncing Dockerfile Ruby version =="
  sync_dockerfile_ruby!

  puts "\n== Updating bundler =="
  # First, so the gem update below runs on that version, not the one that started this script.
  system! "bundle", "update", "--bundler"

  puts "\n== Updating gems (cooldown: #{cooldown} days) =="
  system! "bundle", "update", "--all", "--cooldown", cooldown

  puts "\n== Updating JS packages =="
  system! "bin/aube", "update"

  puts "\n== Aligning Herb npm packages to gem =="
  align_herb_npm_to_gem!

  puts "\n== Upgrading .herb.yml ruleset =="
  upgrade_herb_yml!

  puts "\n== Updating importmap pins =="
  system! "bin/importmap", "update"

  puts "\n== Restoring Chart.js UMD pin =="
  restore_chartjs_umd!

  puts "\n== Restoring PDF.js prebuilt pin =="
  restore_pdfjs_prebuilt!
end if File.expand_path($PROGRAM_NAME) == File.expand_path(__FILE__)
