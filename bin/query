#!/usr/bin/env ruby
# frozen_string_literal: true

# Query API client. No Rails boot. Host: CSA_ADMIN_API_URL (see bin/query -h).

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.expand_path("lib", root))
require "bundler/setup"

begin
  require "dotenv"
  Dotenv.load(
    File.join(root, ".env.development.local"),
    File.join(root, ".env.local"),
    File.join(root, ".env"))
rescue LoadError
end

require "query/cli"

Query::CLI.start(ARGV)
