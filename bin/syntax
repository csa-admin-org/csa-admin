#!/usr/bin/env ruby
# frozen_string_literal: true

# Fast in-process Prism syntax + warning check.
# Usage: bin/syntax [path ...]

require "prism"

module RubySource
  BASENAMES = %w[Gemfile Rakefile].freeze
  EXTENSIONS = %w[.arb .gemspec .rake .rb .ru .ruby].freeze
  RUBY_SHEBANG = /\A#!.*(?:\/|\s)ruby(?:\s|$)/n

  module_function

  def select(paths, root:)
    paths.select { |path| source?(path, root:) }
  end

  def source?(path, root:)
    absolute_path = File.expand_path(path, root)
    return directory_contains_source?(absolute_path) if File.directory?(absolute_path)

    known_name?(path) || File.extname(path).empty? && ruby_shebang?(absolute_path)
  end

  def known_name?(path)
    BASENAMES.include?(File.basename(path)) || EXTENSIONS.include?(File.extname(path))
  end

  def directory_contains_source?(directory)
    Dir.glob("**/*", base: directory).any? { |path|
      absolute_path = File.join(directory, path)
      File.file?(absolute_path) && source?(absolute_path, root: directory)
    }
  end

  def ruby_shebang?(path)
    File.file?(path) && File.binread(path, 256)&.match?(RUBY_SHEBANG) || false
  end
  private_class_method :directory_contains_source?, :ruby_shebang?
end

root = File.expand_path("..", __dir__)
# Prefer these roots over repo-wide ** globs (storage/ has hundreds of thousands of files).
SOURCE_ROOTS = %w[app bin config db lib script test].freeze

def git_files(base)
  output = IO.popen(
    [ "git", "-C", base, "ls-files", "-z", "--cached", "--others", "--exclude-standard" ],
    err: File::NULL,
    &:read)
  return if !$?.success? || output.nil?

  RubySource.select(output.split("\0").reject(&:empty?), root: base)
end

def glob_files(base)
  files = SOURCE_ROOTS.flat_map { |dir|
    directory = File.join(base, dir)
    next [] unless File.directory?(directory)

    Dir.glob("**/*", base: directory).filter_map { |path|
      relative_path = File.join(dir, path)
      relative_path if File.file?(File.join(base, relative_path)) &&
        RubySource.source?(relative_path, root: base)
    }
  }
  files.concat(Dir.children(base).select { |path|
    File.file?(File.join(base, path)) && RubySource.source?(path, root: base)
  })
  files.uniq
end

def discover(base)
  git_files(base) || glob_files(base)
end

def issues_for(file)
  result = Prism.parse_file(file)
  messages = []

  result.errors.each do |error|
    messages << "#{file}:#{error.location.start_line}: #{error.message}"
  end

  result.warnings.each do |warning|
    messages << "#{file}:#{warning.location.start_line}: warning: #{warning.message}"
  end

  messages
end

files =
  if ARGV.empty?
    discover(root)
  else
    ARGV.flat_map { |path|
      absolute_path = File.expand_path(path, root)

      if File.directory?(absolute_path)
        Dir.glob("**/*", base: absolute_path).filter_map { |file|
          selected = File.join(path, file)
          selected if File.file?(File.join(absolute_path, file)) &&
            RubySource.source?(selected, root: root)
        }
      elsif RubySource.source?(path, root: root)
        path
      end
    }.compact.uniq
  end

if files.empty?
  puts "No Ruby files to check."
  exit 0
end

Dir.chdir(root) do
  # git ls-files can still list index paths removed from the worktree.
  existing = files.select { |file| File.file?(file) }
  if existing.empty?
    puts "No Ruby files to check."
    exit 0
  end

  issues = existing.flat_map { |file| issues_for(file) }

  if issues.any?
    puts issues
    exit 1
  end
end
