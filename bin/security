#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage:
#   bin/security
#
# Runs security checks without a Rails boot. Under GitHub Actions,
# Brakeman writes results.sarif for the workflow upload step.

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "security"

Security.run!
