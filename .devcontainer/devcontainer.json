// For format details, see https://containers.dev/implementors/json_reference/.
// For config options, see the README at: https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "csa-admin-${localWorkspaceFolderBasename}",
  // compose.local.yaml: optional personal override, an empty stub otherwise.
  "dockerComposeFile": ["compose.yaml", "compose.local.yaml"],
  "service": "rails-app",
  "workspaceFolder": "/workspaces/app",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/rails/devcontainer/features/sqlite3": {}
  },

  "containerEnv": {
    "KAMAL_REGISTRY_PASSWORD": "$KAMAL_REGISTRY_PASSWORD"
  },

  // No 'forwardPorts': compose.yaml publishes DEV_PORT on the same host port,
  // so each worktree's container gets its own port without editor forwarding.

  // Configure tool-specific properties.
  // "customizations": {},

  // Uncomment to connect as root instead. More info: https://containers.dev/implementors/json_reference/#remoteUser.
  // "remoteUser": "root",

  // Host-side, before the container exists.
  "initializeCommand": "sh .devcontainer/initialize.sh",

  // The image warms mise, gems, and aube under /tmp/deps. This still sets up the
  // mounted workspace (trust, bundle check, test database).
  "postCreateCommand": "bash -lic 'mise trust && mise install && bin/setup --dependencies-only && RAILS_ENV=test bin/rails db:prepare'",
  "postStartCommand": "sh .devcontainer/post-start.sh"
}
